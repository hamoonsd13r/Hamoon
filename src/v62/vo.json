{"total": 174.139, "segs": [{"n": 1, "start": 0.0, "end": 3.343, "text": "توی این شهر، به هرکی هر اسمی بدی... همون می‌شه."}, {"n": 2, "start": 3.621, "end": 7.441, "text": "به داداشت بگی «خوک»، پاپ! خوک می‌شه. تا وقتی که ازش معذرت بخوای."}, {"n": 3, "start": 7.675, "end": 13.04, "text": "البته فحشای معمولی خطری ندارن. «کصخل» و «کص‌مشنگ» که چیزی نیستن آدم بشه... پس هیچی نمی‌شه."}, {"n": 4, "start": 13.275, "end": 15.992, "text": "اینجا فحشِ خطرناک، اسمِ حیووناست."}, {"n": 5, "start": 16.32, "end": 21.0, "text": "خانم حقی هم به شهردار گفت «نی‌نی»... حالا شهردار شهر رو از توی کالسکه اداره می‌کنه."}, {"n": 6, "start": 21.3, "end": 23.4, "text": "من؟ من بدترین داداش بزرگِ شهرم."}, {"n": 7, "start": 23.62, "end": 27.8, "text": "خواهرم نیلو رو یازده بار خوک کردم... و هیچ‌وقت اول من معذرت نخواستم."}, {"n": 8, "start": 28.092, "end": 31.257, "text": "اینو از بابابزرگ دارم. اونم توی عمرش یه بار هم نگفته ببخشید."}, {"n": 9, "start": 31.492, "end": 34.119, "text": "بعد یه شنبه، نیلو دوچرخه‌ی نوم رو گِلی کرد."}, {"n": 10, "start": 36.184, "end": 37.259, "text": "«کرمِ کوچولو!» پاپ!"}, {"n": 11, "start": 37.259, "end": 40.602, "text": "یه کرمِ صورتیِ ریزه، وسطِ حیاطِ بابابزرگ داشت وول می‌خورد."}, {"n": 12, "start": 40.602, "end": 43.754, "text": "بیپ، بیپ! یه ماشین آشغال داشت دنده‌عقب می‌اومد سمتش."}, {"n": 13, "start": 43.754, "end": 45.673, "text": "بعد... ووش! یه کلاغ شیرجه زد و قاپیدش."}, {"n": 14, "start": 45.987, "end": 48.774, "text": "کلاغِ بابابزرگ. همونی که هر صبح بهش نون تست می‌ده."}, {"n": 15, "start": 49.009, "end": 51.163, "text": "پرید تا نوکِ بلندترین کاجِ جنگل."}, {"n": 16, "start": 51.398, "end": 54.481, "text": "بابابزرگ با دمپایی دوید بیرون... فقط زل زد به کلاغه."}, {"n": 17, "start": 54.933, "end": 60.885, "text": "داد زدم: «نیلو! پرنده! خفاش!» هر چیِ پرنده بلد بودم گفتم. باد همه رو برد."}, {"n": 18, "start": 61.12, "end": 64.693, "text": "به کلاغه گفتم «پفیوز!»... هیچی نشد. پفیوز که چیزی نیست."}, {"n": 19, "start": 64.961, "end": 67.913, "text": "اگه فقط یه «ببخشید» بهش می‌رسید، دوباره آدم می‌شد."}, {"n": 20, "start": 68.147, "end": 73.891, "text": "سی متر اون بالا... برای اولین بار توی عمرم، می‌خواستم بگم ببخشید. و نمی‌تونستم."}, {"n": 21, "start": 73.891, "end": 77.332, "text": "و اون بالا، توی لونه، کلاغه روش خم شد. کلاغ‌ها کرم می‌خورن."}, {"n": 22, "start": 77.828, "end": 80.535, "text": "پس دویدم سراغِ تنها کسی که از من بدجنس‌تر بود."}, {"n": 23, "start": 80.78, "end": 82.598, "text": "«بابابزرگ! یه اسمِ پرنده بهم بگو!»"}, {"n": 24, "start": 82.873, "end": 87.101, "text": "غر زد: «من اسمِ قشنگ بلد نیستم. من فقط بلدم بگم کص‌مشنگ.»"}, {"n": 25, "start": 87.427, "end": 89.05, "text": "«بابابزرگ، الان می‌خوردش!»"}, {"n": 26, "start": 89.335, "end": 92.515, "text": "تا حالا به هیچ‌کس اسمِ قشنگ نگفته بود. صورتش قرمز شد."}, {"n": 27, "start": 92.749, "end": 95.088, "text": "«تو... تو... عقابِ گنده!» پاپ!"}, {"n": 28, "start": 95.326, "end": 98.913, "text": "بال! بال‌های غول‌پیکر. و پاهایی مثلِ چنگک باغبونی."}, {"n": 29, "start": 99.158, "end": 102.088, "text": "یه بار بال زدم... و کلِ کوچه کوچیک شد."}, {"n": 30, "start": 102.044, "end": 107.092, "text": "پرواز سخته. رفتم بالا، پایین، کج... دینگ! خوردم به یه دودکش."}, {"n": 31, "start": 107.366, "end": 110.972, "text": "بعد کاج برگشت. لونه کج شد... و نیلو از لبه‌ش سُر خورد."}, {"n": 32, "start": 111.207, "end": 113.917, "text": "شیرجه زدم. پونزده متر. ده. سه. قاپ!"}, {"n": 33, "start": 114.661, "end": 116.797, "text": "با نوکم گرفتمش. داشت وول می‌خورد."}, {"n": 34, "start": 117.032, "end": 119.811, "text": "قانونِ اولِ عقاب بودن: خواهرت رو قورت نده."}, {"n": 35, "start": 120.046, "end": 121.294, "text": "بعد... قار! قار!"}, {"n": 36, "start": 121.544, "end": 124.175, "text": "کلاغه افتاد دنبالمون. تا پایین به دمم نوک زد."}, {"n": 37, "start": 124.409, "end": 126.7, "text": "پرهای دمم رو گرفت و کشید. شَرَق!"}, {"n": 38, "start": 126.995, "end": 130.654, "text": "مثلِ دونه‌ی هلیکوپتری چرخیدیم. نه فرمون داشتم، نه ترمز."}, {"n": 39, "start": 131.063, "end": 132.11, "text": "عقاب‌ها حرف نمی‌زنن."}, {"n": 40, "start": 132.345, "end": 136.516, "text": "پایین توی حیاط، بابابزرگ دستاش رو گذاشت دورِ دهنش: «می‌خوای بگم ببخشید؟»"}, {"n": 41, "start": 136.751, "end": 140.251, "text": "سرم رو محکم تکون دادم. اون بالا، «ببخشید» یعنی سقوط."}, {"n": 42, "start": 140.561, "end": 143.679, "text": "تَرَق! درست افتادم توی بوته‌ی گلِ رزِ بابابزرگ."}, {"n": 43, "start": 143.914, "end": 145.643, "text": "نیلو رو آروم گذاشتم روی چمن."}, {"n": 44, "start": 145.878, "end": 147.794, "text": "بابابزرگ گفت: «ببخشید.» پاپ!"}, {"n": 45, "start": 148.253, "end": 151.29, "text": "دوباره خودم شدم. اولین ببخشیدِ کلِ عمرش."}, {"n": 46, "start": 151.558, "end": 153.698, "text": "کلاغه نشست روی صندوقِ پستش و نگاه کرد."}, {"n": 47, "start": 153.932, "end": 158.551, "text": "یه کرمِ کوچولوی گِلی رو برداشتم، و گفتمش: «ببخشید، نیلو.» پاپ! نیلو!"}, {"n": 48, "start": 158.823, "end": 161.901, "text": "بعد بابابزرگ به کلاغه نگاه کرد. «ببخشید، مهین.» پاپ!"}, {"n": 49, "start": 162.159, "end": 166.71, "text": "مادربزرگم! قبل از اینکه مامان به دنیا بیاد، بابابزرگ بهش گفته بود «کلاغِ پیر»."}, {"n": 50, "start": 166.947, "end": 170.145, "text": "مادربزرگ گفت: «داشتم مواظبش بودم، بزِ پیر!» پاپ!"}, {"n": 51, "start": 170.641, "end": 173.834, "text": "حالا کلِ شهر اول معذرت می‌خواد... به‌جز مادربزرگ."}], "words": [{"w": "توی", "s": 0.0, "e": 0.191, "line": 1}, {"w": "این", "s": 0.191, "e": 0.365, "line": 1}, {"w": "شهر،", "s": 0.365, "e": 0.8, "line": 1}, {"w": "به", "s": 0.8, "e": 1.078, "line": 1}, {"w": "هرکی", "s": 1.078, "e": 1.496, "line": 1}, {"w": "هر", "s": 1.496, "e": 1.791, "line": 1}, {"w": "اسمی", "s": 1.791, "e": 2.209, "line": 1}, {"w": "بدی...", "s": 2.209, "e": 2.47, "line": 1}, {"w": "همون", "s": 2.782, "e": 3.104, "line": 1}, {"w": "می‌شه.", "s": 3.104, "e": 3.343, "line": 1}, {"w": "به", "s": 3.621, "e": 3.706, "line": 2}, {"w": "داداشت", "s": 3.706, "e": 4.011, "line": 2}, {"w": "بگی", "s": 4.011, "e": 4.219, "line": 2}, {"w": "«خوک»،", "s": 4.219, "e": 4.647, "lin