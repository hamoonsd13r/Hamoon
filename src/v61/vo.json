{"total": 174.054, "segs": [{"n": 1, "start": 0.0, "end": 2.702, "text": "توی این شهر، فقط ده بار می‌تونی بگی «ببخشید»."}, {"n": 2, "start": 2.981, "end": 7.48, "text": "یه چیزی رو بشکنی، بگی ببخشید... درجا خودش رو جمع می‌کنه. شَتَق!"}, {"n": 3, "start": 7.801, "end": 11.431, "text": "مثلِ روزِ اولش. ولی هر ببخشید، یکی کم می‌کنه. دینگ!"}, {"n": 4, "start": 11.695, "end": 12.721, "text": "عددش پشتِ دستته."}, {"n": 5, "start": 12.974, "end": 17.469, "text": "همه با ده تا به دنیا میان. به صفر که برسی، «ببخشید» فقط یه کلمه‌ست."}, {"n": 6, "start": 17.878, "end": 20.316, "text": "واسه همین اینجا هیچ‌کس برای چیزای کوچیک نمی‌گه."}, {"n": 7, "start": 20.551, "end": 22.415, "text": "بچه‌ها به‌جاش می‌گن: «حواسم نبود.»"}, {"n": 8, "start": 22.656, "end": 24.602, "text": "هیچ کاری نمی‌کنه... ولی مجانیه."}, {"n": 9, "start": 24.868, "end": 28.828, "text": "وقتی سرویسِ مدرسه دنده‌عقب رفت توی نونوایی، راننده یکی خرج کرد..."}, {"n": 10, "start": 29.038, "end": 31.656, "text": "و سیصد تا دونات پریدن برگشتن پشتِ شیشه."}, {"n": 11, "start": 31.903, "end": 36.009, "text": "وقتی گربه‌مون گلدونِ مامان رو ترک انداخت، بابا با چکش زد داغونش کرد."}, {"n": 12, "start": 36.255, "end": 36.742, "text": "شَتَرَق!"}, {"n": 13, "start": 37.215, "end": 39.707, "text": "«ببخشید.» شَتَق! مثلِ روزِ اولش."}, {"n": 14, "start": 39.971, "end": 43.353, "text": "اون آخرین ببخشیدِ بابا بود. مامان یه هفته باهاش حرف نزد."}, {"n": 15, "start": 43.766, "end": 46.38, "text": "من؟ دوازده سالمه... و فقط یکی برام مونده."}, {"n": 16, "start": 46.615, "end": 48.834, "text": "اصلاً یادم نیست نُه تای دیگه رو کجا خرج کردم."}, {"n": 17, "start": 49.068, "end": 52.373, "text": "بابا فقط می‌خنده و بهم نمی‌گه. واسه همین هیچ‌وقت نمی‌گمش."}, {"n": 18, "start": 52.373, "end": 56.219, "text": "خواهر کوچیکم، مروارید، هفت سالشه، و هر ده تاش رو داره."}, {"n": 19, "start": 56.454, "end": 58.454, "text": "تا حالا حتی یه بار هم نگفته ببخشید."}, {"n": 20, "start": 58.689, "end": 61.275, "text": "حاضره کرم بخوره ولی نگه. یه بار هم خورد."}, {"n": 21, "start": 61.51, "end": 65.15, "text": "جای موردعلاقه‌ش توی دنیا، پلِ طنابیِ قدیمیِ پشتِ خونه‌مونه."}, {"n": 22, "start": 65.415, "end": 67.607, "text": "هر روز روش بالا پایین می‌پره. بوینگ، بوینگ، بوینگ!"}, {"n": 23, "start": 67.607, "end": 70.865, "text": "بابابزرگ بهش می‌گه «پلِ فنری»."}, {"n": 24, "start": 71.115, "end": 73.088, "text": "بعد یه شب، یه طوفانِ بزرگ اومد."}, {"n": 25, "start": 73.341, "end": 77.814, "text": "صبح، پل فقط به یه طناب آویزون بود... و نصفِ تخته‌هاش افتاده بود توی رودخونه."}, {"n": 26, "start": 78.061, "end": 84.738, "text": "کلِ شهر جلسه گذاشت... ولی هیچ‌کس حاضر نبود یه ببخشید رو حرومِ پلی کنه که فقط مروارید ازش استفاده می‌کنه."}, {"n": 27, "start": 84.973, "end": 88.259, "text": "بعد باد بادبادکِ مروارید رو برد و انداخت وسطِ پل..."}, {"n": 28, "start": 88.507, "end": 89.894, "text": "و مروارید دوید دنبالش."}, {"n": 29, "start": 90.156, "end": 92.15, "text": "«مروارید، نه!» ترررق!"}, {"n": 30, "start": 92.609, "end": 93.927, "text": "تخته‌ها زیرِ پاش شکستن."}, {"n": 31, "start": 94.162, "end": 98.788, "text": "آخرین تخته رو گرفت... و همون‌جا آویزون موند. بالای رودخونه. سنگ‌ها اون پایین."}, {"n": 32, "start": 99.023, "end": 102.505, "text": "بابا رفت جلو... ولی طناب غژغژ کرد. زیادی سنگین بود."}, {"n": 33, "start": 102.759, "end": 106.616, "text": "آتش‌نشانی بیست دقیقه راه بود... و انگشت‌های مروارید داشتن سُر می‌خوردن."}, {"n": 34, "start": 106.851, "end": 108.291, "text": "بعد یادِ چکشِ بابا افتادم."}, {"n": 35, "start": 108.526, "end": 112.199, "text": "چیزی رو که خودت نشکستی، نمی‌تونی درست کنی. پس خودت بشکنش."}, {"n": 36, "start": 112.452, "end": 115.876, "text": "اگه آخرین طناب رو می‌بریدم، پل مالِ من می‌شد که درستش کنم."}, {"n": 37, "start": 116.111, "end": 119.874, "text": "یه ببخشید... و کلش برمی‌گرده. و من دقیقاً یکی داشتم."}, {"n": 38, "start": 120.109, "end": 123.293, "text": "ارّه‌ی بابا رو برداشتم و دویدم... و محکم خوردم به بابا."}, {"n": 39, "start": 123.34, "end": 124.62, "text": "«ببخشید!» دینگ!"}, {"n": 40, "start": 124.68, "end": 126.3, "text": "به دستم نگاه کردم. صفر."}, {"n": 41, "start": 126.56, "end": 129.9, "text": "دوازده سال نگفته بودمش... و حرومش کردم سرِ بابا."}, {"n": 42, "start": 130.33, "end": 133.035, "text": "مروارید داشت گریه می‌کرد. ولی مروارید ده تا داشت."}, {"n": 43, "start": 133.27, "end": 136.318, "text": "داد زدم: «مروارید، بپر! بیفت، بعد بگو!»"}, {"n": 44, "start": 136.553, "end": 140.032, "text": "یه نگاه به سنگ‌های پایین کرد... بعد پرید. بوینگ! تَق!"}, {"n": 45, "start": 140.502, "end": 142.973, "text": "کلِ پل ریخت... و مروارید هم باهاش افتاد."}, {"n": 46, "start": 143.208, "end": 144.615, "text": "«ببخشید!» شَتَق!"}, {"n": 47, "start": 144.85, "end": 147.902, "text": "همه‌ی تخته‌ها از توی رودخونه پریدن بالا. شَتَق، شَتَق، شَتَق!"}, {"n": 48, "start": 147.902, "end": 153.524, "text": "طناب‌ها خودشون گره خوردن، و پل وسطِ راه گرفتش... و برش گردوند بالا."}, {"n": 49, "start": 153.792, "end": 158.108, "text": "مثلِ روزِ اولش. مروارید درست وسطش نشسته بود، بادبادکش هم دستش."}, {"n": 50, "start": 158.616, "end": 163.067, "text": "بابابزرگ یه نگاه به مروارید کرد، یه نگاه به من... و خندید. «عینِ خودت.»"}, {"n": 51, "start": 163.301, "end": 165.579, "text": "و بابا بالاخره گفت نُه تای من کجا رفتن."}, {"n": 52, "start": 166.074, "end": 170.085, "text": "وقتی سه سالم بود، اون‌قدر روی اون پل پریدم که شکست. نُه بار."}, {"n": 53, "start": 170.349, "end": 173.814, "text": "بابابزرگم صفره. دو تاش رو... حدس بزن سرِ کدوم پل؟"}], "words": [{"w": "توی", "s": 0.0, "e": 0.226, "line": 1}, {"w": "این", "s": 0.226, "e": 0.383, "line": 1}, {"w": "شهر،", "s": 0.383, "e": 0.817, "line": 1}, {"w": "فقط", "s": 0.817, "e": 1.148, "line": 1}, {"w": "ده", "s": 1.148, "e": 1.478, "line": 1}, {"w": "بار", "s": 1.478, "e": 1.704, "line": 1}, {"w": "می‌تونی", "s": 1.704, "e": 2.0, "line": 1}, {"w": "بگی", "s": 2.0, "e": 2.174, "line": 1}, {"w": "«ببخشید».", "s": 2.174, "e": 2.702, "line": 1}, {"w": "یه", "s": 2.981, "e": 3.088, "line": 2}, {"w": "چیزی", "s": 3.088, "e": 3.297, "lin