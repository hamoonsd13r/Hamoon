{"total": 174.575, "segs": [{"n": 1, "start": 0.0, "end": 2.828, "text": "توی این شهر، خواهر و برادرها دردشون مشترکه."}, {"n": 2, "start": 3.107, "end": 5.867, "text": "یعنی همون لحظه که خواهر یا برادرِ کوچیکت آسیب ببینه..."}, {"n": 3, "start": 5.867, "end": 9.815, "text": "تو هم دقیقاً همون‌جا، همون ثانیه، دردش رو حس می‌کنی."}, {"n": 4, "start": 10.05, "end": 13.817, "text": "ولی کوچیک‌ترها هیچ‌وقت دردِ بزرگ‌ترها رو حس نمی‌کنن. همه همینو می‌گن."}, {"n": 5, "start": 14.202, "end": 16.564, "text": "واسه همین، وقتی یه نی‌نی سرش می‌خوره به میز..."}, {"n": 6, "start": 16.799, "end": 19.312, "text": "داداش بزرگش اون سرِ شهر از دوچرخه پرت می‌شه."}, {"n": 7, "start": 19.547, "end": 21.5, "text": "خانواده‌ی حیدری یازده تا بچه دارن."}, {"n": 8, "start": 21.735, "end": 25.721, "text": "وقتی کوچیکه سکندری می‌خوره، ده تا بچه مثلِ دومینو پخش زمین می‌شن."}, {"n": 9, "start": 26.036, "end": 27.171, "text": "آخ، آخ، آخ!"}, {"n": 10, "start": 27.241, "end": 31.614, "text": "من؟ من یه خواهر کوچیک دارم. نخودی. شش سالشه... و از رو همه‌چی می‌افته."}, {"n": 11, "start": 31.849, "end": 35.118, "text": "من تا حالا از سیصد تا چیز افتادم که هیچ‌وقت ازشون بالا نرفته بودم."}, {"n": 12, "start": 35.353, "end": 37.73, "text": "تاب، دیوار... یه بار هم از رو یه گاو."}, {"n": 13, "start": 37.965, "end": 41.082, "text": "واسه همین همه‌جا کلاه‌کاسکت می‌ذارم. حتی سرِ کلاسِ ریاضی."}, {"n": 14, "start": 41.325, "end": 43.565, "text": "مامان فقط می‌گه: «یه روز ازش ممنون می‌شی.»"}, {"n": 15, "start": 43.801, "end": 47.325, "text": "ولی نخودی هیچ‌وقت گریه نمی‌کنه. حتی وقتی با صورت می‌خوره زمین."}, {"n": 16, "start": 47.559, "end": 51.554, "text": "وقتی من از درخت می‌افتم، فقط زانوی خودش رو می‌ماله و می‌گه: «دوباره برو بالا.»"}, {"n": 17, "start": 51.905, "end": 56.123, "text": "هر زمستون، ماشین‌های برف‌روبی همه‌ی برفِ شهر رو پشتِ مدرسه کپه می‌کنن."}, {"n": 18, "start": 56.358, "end": 59.326, "text": "اسمش رو گذاشتیم کوهِ پارویی. دوازده متر قدشه."}, {"n": 19, "start": 59.326, "end": 63.88, "text": "بچه‌ها توش تونل می‌کنن. فقط یه قانون داره: هیچ‌وقت عمیق‌تر از دستت نکَن."}, {"n": 20, "start": 64.115, "end": 66.841, "text": "ولی نخودی می‌خواست عمیق‌ترین تونلِ تاریخ رو بکنه."}, {"n": 21, "start": 67.075, "end": 69.333, "text": "بعد، یه شنبه، صداش رو شنیدم."}, {"n": 22, "start": 69.333, "end": 69.843, "text": "ترررق!"}, {"n": 23, "start": 70.339, "end": 73.668, "text": "نخودی اون‌قدر رفته بود تو که حتی پوتین‌هاش هم دیده نمی‌شد."}, {"n": 24, "start": 73.903, "end": 77.103, "text": "کوهِ پارویی مثلِ یه موجِ غول‌پیکر سُر خورد پایین."}, {"n": 25, "start": 77.598, "end": 78.13, "text": "بووم!"}, {"n": 26, "start": 78.529, "end": 81.893, "text": "کلِ کپه جابه‌جا شده بود... و هیچ‌کس نمی‌دونست تونلش کجاست."}, {"n": 27, "start": 82.128, "end": 85.362, "text": "بعد یهو اومد سراغم. سرما. همه‌جای بدنم."}, {"n": 28, "start": 85.597, "end": 88.577, "text": "و سنگینی... انگار یه ماشین روی سینه‌م پارک کرده بود."}, {"n": 29, "start": 88.845, "end": 91.958, "text": "درد داشت. و اگه درد داره... یعنی هنوز زنده‌ست."}, {"n": 30, "start": 92.389, "end": 95.502, "text": "ماشین‌های آتش‌نشانیِ سروان دلارام چهار دقیقه‌ای رسیدن."}, {"n": 31, "start": 95.737, "end": 100.09, "text": "بیست تا آتش‌نشان با میله‌های فلزیِ بلند، قدم به قدم برف رو سوراخ می‌کردن."}, {"n": 32, "start": 100.325, "end": 103.557, "text": "ولی کپه پر از تیکه‌یخ بود. هر میله‌ای به یه چیزی می‌خورد."}, {"n": 33, "start": 103.791, "end": 106.189, "text": "سروان گفت: «دو ساعت طول می‌کشه همه‌ش رو بگردیم.»"}, {"n": 34, "start": 106.423, "end": 109.187, "text": "مامان زانو زده بود و اسمِ نخودی رو توی برف داد می‌زد."}, {"n": 35, "start": 109.421, "end": 111.824, "text": "و زیرِ برف، فقط حدودِ سی دقیقه هوا داری."}, {"n": 36, "start": 112.059, "end": 115.761, "text": "بعد سرمای انگشت‌هام کم‌کم داشت می‌رفت... و فهمیدم این بده."}, {"n": 37, "start": 115.999, "end": 117.115, "text": "وقتی دیگه درد نکنه..."}, {"n": 38, "start": 117.617, "end": 120.668, "text": "دوباره به میله‌ها نگاه کردم. نخودی هنوز حسشون نمی‌کرد."}, {"n": 39, "start": 120.902, "end": 124.292, "text": "ولی اگه یکیش بهش می‌خورد، دردش می‌اومد... و من حسش می‌کردم."}, {"n": 40, "start": 124.527, "end": 127.11, "text": "داد زدم: «یکی‌یکی! محکم فرو کنید!»"}, {"n": 41, "start": 127.14, "end": 129.17, "text": "فرو، هیچی. فرو، هیچی."}, {"n": 42, "start": 129.66, "end": 131.17, "text": "یخ، یخ، یخ!"}, {"n": 43, "start": 131.48, "end": 132.41, "text": "پونزده دقیقه مونده."}, {"n": 44, "start": 132.74, "end": 134.67, "text": "فرو، هیچی. ده دقیقه."}, {"n": 45, "start": 134.86, "end": 135.97, "text": "میله‌ی شماره‌ی چهارده..."}, {"n": 46, "start": 136.2, "end": 138.29, "text": "آخ! شونه‌ی چپم! همون!"}, {"n": 47, "start": 138.731, "end": 141.309, "text": "با دستای خالی کندم. یخ‌ها دستام رو بریدن."}, {"n": 48, "start": 141.816, "end": 143.585, "text": "یه بیل خورد به کلاهم. دینگ!"}, {"n": 49, "start": 143.819, "end": 145.657, "text": "باز کندم. یه متر. دو متر."}, {"n": 50, "start": 145.887, "end": 147.445, "text": "بعد... یه دستکشِ قرمز."}, {"n": 51, "start": 147.68, "end": 150.12, "text": "نخودی، یخِ یخ، چشماش بسته."}, {"n": 52, "start": 150.616, "end": 151.348, "text": "بعد سرفه کرد."}, {"n": 53, "start": 151.583, "end": 154.817, "text": "آروم گفت: «دستات... اون‌قدر درد می‌کرد که بیدار موندم.»"}, {"n": 54, "start": 155.052, "end": 157.923, "text": "خشکم زد. کوچیک‌ترها هیچ‌وقت درد رو حس نمی‌کنن."}, {"n": 55, "start": 158.158, "end": 160.647, "text": "ولی نخودی تک‌تکِ دردهای من رو حس کرده بود."}, {"n": 56, "start": 160.882, "end": 164.297, "text": "فقط هیچ‌وقت گریه نکرده بود... که من از بالا رفتن دست نکشم."}, {"n": 57, "start": 164.532, "end": 166.228, "text": "پس بالاخره ازش تشکر کردم."}, {"n": 58, "start": 166.462, "end": 170.443, "text": "بعد نخودی پاشد... و انگشتِ پاش خورد به ماشینِ آتش‌نشانی."}, {"n": 59, "start": 170.678, "end": 173.292, "text": "و برای اولین بار، دوتامون با هم داد زدیم:"}, {"n": 60, "start": 173.836, "end": 174.271, "text": "آخ!"}], "words": [{"w": "توی", "s": 0.0, "e": 0.191, "line": 1}, {"w": "این", "s": 0.191, "e": 0.365, "lin