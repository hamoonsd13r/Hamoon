{"total": 72.981, "segs": [{"n": 1, "start": 0.0, "end": 3.947, "text": "توی این دنیا، اگه شب صدای آهنگِ ماشینِ بستنی‌فروشی رو شنیدی..."}, {"n": 2, "start": 3.947, "end": 7.235, "text": "شصت ثانیه وقت داری بری توی خونه. قبل از اینکه ماشین وایسه."}, {"n": 3, "start": 7.633, "end": 9.425, "text": "هیچ‌کس نمی‌دونه کی پشتِ فرمونشه."}, {"n": 4, "start": 9.691, "end": 12.46, "text": "بچه‌هایی که سمتش دویدن... دیگه هیچ‌وقت پیدا نشدن."}, {"n": 5, "start": 12.902, "end": 14.559, "text": "و امشب، آهنگ شروع شد..."}, {"n": 6, "start": 14.825, "end": 16.842, "text": "در حالی که تیامِ کوچولو هنوز بیرون بود."}, {"n": 7, "start": 17.107, "end": 18.952, "text": "و اون، مستقیم دوید سمتش."}, {"n": 8, "start": 19.247, "end": 21.312, "text": "فقط خواهر بزرگش، النا، دید که رفت."}, {"n": 9, "start": 21.578, "end": 23.592, "text": "همه‌ی درهای کوچه محکم بسته شدن..."}, {"n": 10, "start": 23.858, "end": 26.172, "text": "و النا تنها کسی بود که داشت می‌دوید بیرون."}, {"n": 11, "start": 26.438, "end": 26.747, "text": "پنجاه."}, {"n": 12, "start": 27.145, "end": 29.256, "text": "چراغای خیابون یکی‌یکی خاموش شدن."}, {"n": 13, "start": 29.521, "end": 29.946, "text": "چهل."}, {"n": 14, "start": 30.222, "end": 32.021, "text": "از توی حیاطِ خونه‌ها میون‌بُر زد."}, {"n": 15, "start": 32.287, "end": 32.621, "text": "سی."}, {"n": 16, "start": 32.895, "end": 34.336, "text": "تیام رو سرِ کوچه پیدا کرد..."}, {"n": 17, "start": 34.601, "end": 36.975, "text": "درست وقتی ماشین آروم پیچید توی کوچه‌شون."}, {"n": 18, "start": 37.241, "end": 38.585, "text": "هیچ‌کس پشتِ فرمون نبود."}, {"n": 19, "start": 39.043, "end": 39.41, "text": "بیست."}, {"n": 20, "start": 39.72, "end": 41.369, "text": "النا دستش رو گرفت و دویدن..."}, {"n": 21, "start": 41.641, "end": 44.046, "text": "و آهنگ پشتِ سرشون هی بلندتر می‌شد."}, {"n": 22, "start": 44.311, "end": 44.863, "text": "یازده."}, {"n": 23, "start": 45.135, "end": 47.033, "text": "شیشه‌ی ماشین آروم باز شد..."}, {"n": 24, "start": 47.298, "end": 49.585, "text": "و یه دستِ درازِ خاکستری اومد بیرون..."}, {"n": 25, "start": 49.891, "end": 51.691, "text": "و کلاهِ سوئیشرتِ تیام رو گرفت."}, {"n": 26, "start": 51.956, "end": 53.329, "text": "سوئیشرت از تنش دراومد..."}, {"n": 27, "start": 53.594, "end": 54.756, "text": "و اون همین‌طور دوید."}, {"n": 28, "start": 55.022, "end": 55.403, "text": "پنج."}, {"n": 29, "start": 55.676, "end": 56.865, "text": "شیرجه زدن توی خونه..."}, {"n": 30, "start": 57.13, "end": 59.636, "text": "درست همون لحظه که مامان در رو محکم بست."}, {"n": 31, "start": 59.932, "end": 60.296, "text": "بیرون،"}, {"n": 32, "start": 60.593, "end": 62.527, "text": "آهنگ درست جلوی خونه‌شون قطع شد."}, {"n": 33, "start": 62.793, "end": 63.022, "text": "بعد..."}, {"n": 34, "start": 63.331, "end": 64.291, "text": "همه‌جا ساکت شد."}, {"n": 35, "start": 64.911, "end": 65.665, "text": "و همین الان..."}, {"n": 36, "start": 66.019, "end": 67.445, "text": "آهنگ دوباره شروع شد."}, {"n": 37, "start": 67.892, "end": 70.513, "text": "این بار، تو ده ثانیه وقت داری یه لایک بزنی..."}, {"n": 38, "start": 70.814, "end": 72.707, "text": "قبل از اینکه ماشین جلوی خونه‌ی تو وایسه."}], "words": [{"w": "توی", "s": 0.0, "e": 0.212, "line": 1}, {"w": "این", "s": 0.212, "e": 0.372, "line": 1}, {"w": "دنیا،", "s": 0.372, "e": 0.779, "line": 1}, {"w": "اگه", "s": 0.779, "e": 1.221, "line": 1}, {"w": "شب", "s": 1.221, "e": 1.469, "line": 1}, {"w": "صدای", "s": 1.469, "e": 1.894, "line": 1}, {"w": "آهنگِ", "s": 1.894, "e": 2.23, "line": 1}, {"w": "ماشینِ", "s": 2.23, "e": 2.655, "line": 1}, {"w": "بستنی‌فروشی", "s": 2.655, "e": 3.434, "line": 1}, {"w": "رو", "s": 3.434, "e": 3.575, "line": 1}, {"w": "شنیدی...", "s": 3.575, "e": 3.947, "line": 1}, {"w": "شصت", "s": 3.947, "e": 4.022, "line": 2}, {"w": "ثانیه", "s": 4.305, "e": 4.895, "line": 2}, {"w": "وقت", "s": 4.895, "e": 5.142, "line": 2}, {"w": "داری", "s": 5.142, "e": 5.337, "line": 2}, {"w": "بری", "s": 5.337, "e": 5.514, "line": 2}, {"w": "توی", "s": 5.514, "e": 5.691, "line": 2}, {"w": "خونه.", "s": 5.691,