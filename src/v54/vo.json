{"total": 178.124, "segs": [{"n": 1, "start": 0.0, "end": 3.854, "text": "توی این شهر، وقتی ناقوسِ شب می‌زنه... همه یخ می‌زنن."}, {"n": 2, "start": 4.275, "end": 6.678, "text": "اگه نگهبان ببینه تکون خوردی، می‌برتت."}, {"n": 3, "start": 7.159, "end": 8.849, "text": "من بهترین مجسمه‌ی این شهرم."}, {"n": 4, "start": 9.1, "end": 10.938, "text": "تا حالا حتی یه بارم تکون نخوردم."}, {"n": 5, "start": 11.146, "end": 14.279, "text": "بچه‌ها قبل از اینکه راه رفتن یاد بگیرن، یخ زدن یاد می‌گیرن."}, {"n": 6, "start": 14.517, "end": 17.189, "text": "پارسال، وسطِ مسابقه‌ی کیک‌خوری ناقوس زد..."}, {"n": 7, "start": 17.412, "end": 20.356, "text": "و چهل نفر تا صبح با صورت توی کیکشون موندن."}, {"n": 8, "start": 20.569, "end": 22.446, "text": "هیچ‌کس نمی‌دونه نگهبان از کجا میاد."}, {"n": 9, "start": 22.667, "end": 25.276, "text": "وقتی یخ زدی، نمی‌تونی سرت رو برگردونی ببینی."}, {"n": 10, "start": 25.497, "end": 27.537, "text": "ولی هر صبح، بعد از یه شبِ ناقوس،"}, {"n": 11, "start": 27.802, "end": 32.205, "text": "آقای پرویزی یه کپه سنگ‌ریزه‌ی خاکستری رو از وسطِ میدون جارو می‌کنه."}, {"n": 12, "start": 32.415, "end": 34.585, "text": "درست زیرِ مجسمه‌ی سنگیِ بزرگ."}, {"n": 13, "start": 34.887, "end": 37.798, "text": "خواهر کوچیکم، مینا، بدترین مجسمه‌ی شهره."}, {"n": 14, "start": 38.109, "end": 40.938, "text": "ریز ریز می‌خنده، وول می‌خوره، عطسه می‌کنه."}, {"n": 15, "start": 41.145, "end": 43.377, "text": "واسه همین هر شب قبل از خواب تمرین می‌کنیم."}, {"n": 16, "start": 43.592, "end": 47.473, "text": "بهش می‌گم: «مثلِ سنگ، بی‌تکون... تا صبح، توی خونه‌مون.»"}, {"n": 17, "start": 47.709, "end": 49.576, "text": "اونم تکرار می‌کنه... بعد تکون می‌خوره."}, {"n": 18, "start": 49.785, "end": 51.958, "text": "جمعه‌ی پیش، توی شهربازیِ میدون بودیم."}, {"n": 19, "start": 52.177, "end": 55.25, "text": "درست زیرِ مجسمه‌ی سنگیِ بزرگ... که ناقوس زد."}, {"n": 20, "start": 55.62, "end": 57.88, "text": "دَنگ... دَنگ... دَنگ..."}, {"n": 21, "start": 58.396, "end": 59.676, "text": "کلِ شهر یخ زد."}, {"n": 22, "start": 59.916, "end": 61.376, "text": "مینا درست کنارم یخ زد."}, {"n": 23, "start": 61.616, "end": 63.388, "text": "پشمکش تقریباً توی دهنش بود."}, {"n": 24, "start": 63.597, "end": 66.836, "text": "بعد، یه جایی پشتِ سرم... یه چیزِ سنگین پا گذاشت زمین."}, {"n": 25, "start": 67.075, "end": 67.366, "text": "تاپ!"}, {"n": 26, "start": 67.847, "end": 69.087, "text": "از خونه‌ها بلندتر بود."}, {"n": 27, "start": 69.305, "end": 71.059, "text": "سنگِ خاکستریِ ترک‌خورده..."}, {"n": 28, "start": 71.281, "end": 73.34, "text": "و صورتش، صورتِ یه بچه بود."}, {"n": 29, "start": 73.585, "end": 75.987, "text": "از کنارمون رد شد و از میدون رفت بیرون."}, {"n": 30, "start": 76.241, "end": 79.085, "text": "ساعتِ ده، اون‌ورِ کتابخونه، یه گوشی زنگ خورد."}, {"n": 31, "start": 79.321, "end": 81.022, "text": "یکی هین کشید... بعد ساکت شد."}, {"n": 32, "start": 81.237, "end": 82.84, "text": "نیمه‌شب. تاپ... تاپ..."}, {"n": 33, "start": 83.137, "end": 83.954, "text": "برگشت به میدون."}, {"n": 34, "start": 84.173, "end": 85.977, "text": "درست جلوی مینا وایساد و خم شد."}, {"n": 35, "start": 86.213, "end": 89.421, "text": "اون‌قدر نزدیک بود که نفسش موهای مینا رو تکون می‌داد."}, {"n": 36, "start": 89.63, "end": 91.042, "text": "بعد... دماغش جمع شد."}, {"n": 37, "start": 91.26, "end": 92.416, "text": "داشت عطسه‌ش می‌گرفت."}, {"n": 38, "start": 92.641, "end": 96.22, "text": "با تمومِ وجودم توی دلم گفتم: مثلِ سنگ، بی‌تکون..."}, {"n": 39, "start": 96.446, "end": 98.984, "text": "مثلِ سنگ، بی‌تکون... نگهش داشت."}, {"n": 40, "start": 99.2, "end": 100.264, "text": "بعد برگشت سمتِ من."}, {"n": 41, "start": 100.512, "end": 104.353, "text": "چشمِ خاکستریِ بزرگش، یه بند انگشت با چشمم فاصله داشت."}, {"n": 42, "start": 104.568, "end": 105.282, "text": "پلک نزدم."}, {"n": 43, "start": 105.57, "end": 109.123, "text": "سرش رو آروم کج کرد... انگار بهم افتخار می‌کرد."}, {"n": 44, "start": 109.123, "end": 111.115, "text": "ساعتِ یک، یه پشه نشست روی دماغم."}, {"n": 45, "start": 111.33, "end": 112.344, "text": "گذاشتم نیشم بزنه."}, {"n": 46, "start": 112.577, "end": 115.993, "text": "دو، پشمکِ مینا از چوبش سُر خورد و افتاد روی کفشش."}, {"n": 47, "start": 115.993, "end": 117.663, "text": "حتی پایین رو نگاه نکرد."}, {"n": 48, "start": 117.987, "end": 120.775, "text": "سه... چهار... نگهبان دورِ میدون می‌چرخید."}, {"n": 49, "start": 121.164, "end": 121.866, "text": "تاپ... تاپ..."}, {"n": 50, "start": 122.119, "end": 125.633, "text": "و هر بار که از کنارم رد می‌شد، یه کم بیشتر جلوی من وایمیستاد."}, {"n": 51, "start": 125.893, "end": 127.548, "text": "پنج، آسمون صورتی شد."}, {"n": 52, "start": 127.774, "end": 129.088, "text": "بعد، خورشید دراومد."}, {"n": 53, "start": 129.303, "end": 132.67, "text": "پشتِ سرم، یه چیزی ترک خورد و ریخت... مثلِ ریزشِ کوه."}, {"n": 54, "start": 132.899, "end": 135.118, "text": "کلِ شهر از یخ دراومد و هورا کشید."}, {"n": 55, "start": 135.341, "end": 136.952, "text": "مینا جیغ زد: «تونستیم!»"}, {"n": 56, "start": 137.183, "end": 138.371, "text": "و دوید که بغلم کنه."}, {"n": 57, "start": 138.584, "end": 139.668, "text": "نتونستم بغلش کنم."}, {"n": 58, "start": 139.885, "end": 142.923, "text": "نمی‌تونستم تکون بخورم... و مینا داشت بالا رو نگاه می‌کرد."}, {"n": 59, "start": 143.237, "end": 144.012, "text": "خیلی بالا."}, {"n": 60, "start": 144.54, "end": 146.293, "text": "دستام سنگِ خاکستری شده بودن."}, {"n": 61, "start": 146.512, "end": 150.146, "text": "من همون‌جایی وایساده بودم که قبلاً مجسمه‌ی سنگیِ بزرگ بود."}, {"n": 62, "start": 150.374, "end": 152.998, "text": "زیرِ پام، یه کپه سنگ‌ریزه‌ی خاکستری بود."}, {"n": 63, "start": 153.486, "end": 154.214, "text": "تازه فهمیدم."}, {"n": 64, "start": 154.436, "end": 155.903, "text": "نگهبان یه هیولا نیست."}, {"n": 65, "start": 156.133, "end": 160.392, "text": "هر شبِ ناقوس، بی‌تکون‌ترین بچه‌ی شهر... نگهبانِ بعدی می‌شه."}, {"n": 66, "start": 160.671, "end": 162.432, "text": "و این بار... اون من بودم."}, {"n": 67, "start": 163.052, "end": 164.85, "text": "حالا کلِ روز وسطِ میدون وایسادم."}, {"n": 68, "start": 165.097, "end": 168.514, "text": "و هر صبح، مینا میاد جلوم وایمیسته... تا تمرین کنه."}, {"n": 69, "start": 168.725, "end": 169.95, "text": "دیگه ریز ریز نمی‌خنده."}, {"n": 70, "start": 170.173, "end": 171.12, "text": "دیگه وول نمی‌خوره."}, {"n": 71, "start": 171.337, "end": 172.487, "text": "داره خیلی خوب می‌شه."}, {"n": 72, "start": 172.703, "end": 177.806, "text": "آروم رو به بالا زمزمه می‌کنه: «مثلِ سنگ، بی‌تکون... تا صبح، توی خونه‌مون.»"}], "words": [{"w": "توی", "s": 0.0, "e": 0.22, "line": 1}, {"w": "این", "s": 0.22, "e": 0.4, "line": 1}, {"w": "شهر،", "s": 0.4, "e": 0.8, "line": 1}, {"w": "وقتی", "s": 0.8, "e": 1.18, "line": 1}, {"w": "ناقوسِ", "s": 1.18, "e": 1.6, "line": 1}, {"w": "شب", "s": 1.6, "e": 1.92, "line": 1}, {"w": "می‌زنه...", "s": 1.92, "e": 2.44, "line": 1}, {"w": "همه", "s": 2.732, "e": 3.174, "line": 1}, {"w": "یخ", "s": 3.174, "e": 3.414, "line": 1}, {"w": "می‌زنن.", "s": 3.414, "e": 3.854, "line": 1}, {"w": "اگه", "s": 4.275, "e": 4.418, "line": 2}, {"w": "نگهبان", "s": 4.418, "e": 4.858, "line": 2}, {"w": "ببینه", "s": 4.858, "e": 5.178, "line": 2}, {"w": "تکون", "s": 5.178, "e": 5.458, "line": 2}, {"w": "خوردی،", "s": 5.458, "e": 5.898, "line": 2}, {"w": "می‌برتت.", "s": 5.898, "e": 6.678, "line": 2}, {"w": "من", "s": 7.159, "e": 7.249, "line": 3}, {"w": "بهترین", "s": 7.249, "e": 7.849, "line": 3}, {"w": "مجسمه‌ی", "s": 7.849, "e": 8.369, "line": 3}, {"w": "این", "s": 8.369, "e": 8.509, "line": 3}, {"w": "شهرم.", "s": 8.509, "e": 8.849, "line": 3}, {"w": "تا", "s": 9.1, "e": 9.183, "line": 4}, {"w": "حالا", "s": 9.379, "e": 9.579, "line": 4}, {"w": "حتی", "s": 9.579, "e": 9.818, "line": 4}, {"w": "یه", "s": 9.818, "e": 9.997, "line": 4}, {"w": "بارم", "s": 9.997, "e": 10.297, "line": 4}, {"w": "تکون", "s": 10.297, "e": 10.525, "line": 4}, {"w": "نخوردم.", "s": 10.525, "e": 10.938, "line": 4}, {"w": "بچه‌ها", "s": 11.146, "e": 11.489, "line": 5}, {"w": "قبل", "s": 11.489, "e": 11.709, "line": 5}, {"w": "از", "s": 11.709, "e": 11.809, "l