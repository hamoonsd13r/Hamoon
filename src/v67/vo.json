{"total": 168.176, "segs": [{"n": 1, "start": 0.0, "end": 3.51, "text": "توی این دنیا، هر بار عطسه کنی، یه کم بیشتر اژدها می‌شی."}, {"n": 2, "start": 3.782, "end": 7.642, "text": "و من الان نُه تا زدم. یکی دیگه... و دیگه هیچ‌وقت نمی‌تونم برگردم خونه."}, {"n": 3, "start": 8.125, "end": 10.37, "text": "یه عطسه، فلس‌های سبز. هاپچه!"}, {"n": 4, "start": 10.599, "end": 12.48, "text": "بعد دُم، چنگال، شاخ."}, {"n": 5, "start": 12.48, "end": 15.686, "text": "هفت تا عطسه، بال درمیاری. هشت تا، آتیش."}, {"n": 6, "start": 15.93, "end": 18.393, "text": "ولی ده تا... برای همیشه اژدها می‌شی."}, {"n": 7, "start": 18.834, "end": 23.935, "text": "اژدها توی خونه جا نمی‌شه. همه‌شون می‌رن بالای کوهِ اژدها، و یه عالمه می‌خوابن. چند سال."}, {"n": 8, "start": 24.164, "end": 27.967, "text": "واسه همین آدم‌بزرگ‌ها هر عطسه‌ای رو قورت می‌دن. بچه‌ها... نه زیاد."}, {"n": 9, "start": 28.196, "end": 32.335, "text": "اینجا آرایشگاه‌ها شاخ کوتاه می‌کنن. نونوایی‌ها تنور رو با یه عطسه روشن می‌کنن."}, {"n": 10, "start": 32.564, "end": 35.482, "text": "و پرشِ ارتفاعِ المپیک... الان فقط پروازه."}, {"n": 11, "start": 35.88, "end": 38.014, "text": "من؟ من تا حالا یه بار هم عطسه نکردم."}, {"n": 12, "start": 38.243, "end": 43.56, "text": "بابابزرگم یه ترفند یادم داد: هر وقت دماغت قلقلک شد، داد بزن «ماکارونی!» بلند!"}, {"n": 13, "start": 43.789, "end": 46.849, "text": "منم سرِ کلاس داد می‌زنم. وسطِ نمایشِ مدرسه هم داد زدم."}, {"n": 14, "start": 47.078, "end": 51.64, "text": "بردیا بهم می‌گه «ماکارونی». تنها بچه‌ی کلاس چهارمم که هیچ فلسی نداره."}, {"n": 15, "start": 51.869, "end": 54.192, "text": "بابابزرگم شصت ساله که روی نُه تا عطسه مونده."}, {"n": 16, "start": 54.421, "end": 59.237, "text": "روزی چهل بار می‌گه «ماکارونی». و هیچ‌وقت نمی‌ره بالای کوه. می‌گه: «خاکش زیاده.»"}, {"n": 17, "start": 59.535, "end": 62.74, "text": "ولی هر شب، کنارِ پنجره می‌شینه و به کوه زل می‌زنه."}, {"n": 18, "start": 63.223, "end": 64.938, "text": "بعد، روزِ اردوی آسمون رسید."}, {"n": 19, "start": 65.17, "end": 69.864, "text": "هر سال کلاس چهارمی‌ها پرواز می‌کنن بالای کوه، تا اژدهاها رو ببینن. فقط با بال."}, {"n": 20, "start": 70.141, "end": 71.539, "text": "همه بال داشتن. به‌جز من."}, {"n": 21, "start": 71.767, "end": 73.643, "text": "بردیا گفت: «برگه‌ت رو حل کن، ماکارونی.»"}, {"n": 22, "start": 73.929, "end": 76.546, "text": "منم رفتم بیرون و مستقیم به خورشید نگاه کردم."}, {"n": 23, "start": 76.775, "end": 79.951, "text": "بعضیا با نورِ خورشید عطسه‌شون می‌گیره. معلوم شد منم یکی از اونام."}, {"n": 24, "start": 80.199, "end": 82.415, "text": "و برای اولین بار... «ماکارونی» نگفتم."}, {"n": 25, "start": 82.898, "end": 86.048, "text": "هاپچه! فلس. هاپچه! هاپچه! دُم و چنگال."}, {"n": 26, "start": 86.308, "end": 90.172, "text": "هاپچه! هاپچه! شاخ. هاپچه! هاپچه! بال. هفت تا."}, {"n": 27, "start": 90.401, "end": 91.898, "text": "و می‌تونستم پرواز کنم!"}, {"n": 28, "start": 92.328, "end": 95.054, "text": "از کنارِ بردیا رد شدم. بالای ابرها یه دور زدم."}, {"n": 29, "start": 95.283, "end": 99.551, "text": "بعد رسیدیم به غارِ اژدهاها. غول‌پیکر و خاکی، پر از اژدهاهای خواب."}, {"n": 30, "start": 99.78, "end": 103.732, "text": "گنده‌ترین اژدها غلت زد... و یه ابرِ خاک ریخت روی کلِ کلاس."}, {"n": 31, "start": 103.988, "end": 107.004, "text": "هاپچه! فوووش! آتیش! هشت تا."}, {"n": 32, "start": 107.233, "end": 108.134, "text": "هاپچه! نُه."}, {"n": 33, "start": 108.667, "end": 112.127, "text": "خانم فرزانه داد زد: «همه بیرون!» کلاس پرواز کرد بیرون."}, {"n": 34, "start": 112.356, "end": 116.358, "text": "توی اون همه خاک، کسی منو ندید. دُمِ اژدهای غول افتاده بود روی بالم."}, {"n": 35, "start": 116.587, "end": 119.621, "text": "نمی‌تونستم تکون بخورم. و دماغم دوباره قلقلک می‌شد."}, {"n": 36, "start": 119.849, "end": 124.273, "text": "یه عطسه‌ی دیگه، و برای همیشه اینجا می‌موندم. بدون بابابزرگ. بدون خونه."}, {"n": 37, "start": 124.756, "end": 126.971, "text": "پس همون کاری رو کردم که همه بهش می‌خندیدن."}, {"n": 38, "start": 127.2, "end": 130.454, "text": "«ماکارونی!» قلقلکه رفت. ولی خاک هنوز می‌ریخت."}, {"n": 39, "start": 130.683, "end": 133.515, "text": "«ماکارونی! ماکارونی!» صدام شکست."}, {"n": 40, "start": 133.797, "end": 137.158, "text": "قلقلک برگشت. چشمام پر از اشک شد. هاپ... هاپ..."}, {"n": 41, "start": 137.387, "end": 142.322, "text": "بعد اژدهای غول یه چشمش رو باز کرد. یه چشمِ زردِ بزرگ. زل زد به من."}, {"n": 42, "start": 142.34, "end": 145.7, "text": "بعد دُمش رو برداشت... و من مثلِ برق زدم بیرون."}, {"n": 43, "start": 145.82, "end": 149.3, "text": "اون شب به بابابزرگ گفتم با «ماکارونی» یه اژدها ولم کرد."}, {"n": 44, "start": 149.531, "end": 152.195, "text": "گفت: «ماکارونی، ترفندِ مادربزرگت بود.»"}, {"n": 45, "start": 152.424, "end": 157.767, "text": "«وقتی مامانت نوزاد بود، عطسه‌ی دهمش رو زد. من موندم، به‌خاطرِ مامانت. بعد به‌خاطرِ تو.»"}, {"n": 46, "start": 158.271, "end": 161.097, "text": "بعد به بال‌هام نگاه کرد... و این بار «ماکارونی» نگفت."}, {"n": 47, "start": 161.793, "end": 162.188, "text": "هاپچه!"}, {"n": 48, "start": 162.416, "end": 167.971, "text": "حالا بابابزرگ با مادربزرگ بالای کوه زندگی می‌کنه... و هر روز ساعت سه، از مدرسه میان دنبالم."}], "words": [{"w": "توی", "s": 0.0, "e": 0.186, "line": 1}, {"w": "این", "s": 0.186, "e": 0.356, "line": 1}, {"w": "دنیا،", "s": 0.356, "e": 0.746, "line": 1}, {"w": "هر", "s": 0.746, "e": 1.22, "line": 1}, {"w": "بار", "s": 1.22, "e": 1.508, "line": 1}, {"w": "عطسه", "s": 1.508, "e": 1.826, "line": 1}, {"w": "کنی،", "s": 1.826, "e": 2.144, "line": 1}, {"w": "یه", "s": 2.144, "e": 2.335, "line": 1}, {"w": "کم", "s": 2.335, "e": 2.525, "line": 1}, {"w": "بیشتر", "s": 2.525, "e": 2.949, "line": 1}, {"w": "اژدها", "s": 2.949, "e": 3.273, "line": 1}, {"w": "می‌شی.", "s": 3.273, "e": 3.51, "line": 1}, {"w": "و", "s": 3.782, "e": 3.804, "line": 2}, {"w": "من", "s": 3.804, "e": 3.939, "line": 2}, {"w": "الان", "s": 3.939, "e": 4.143, "line": 2}, {"w": "نُه", "s": 4.143, "e": 4.453, "line": 2}, {"w": "تا", "s": 4.453, "e": 4.763, "line": 2}, {"w": "زدم.", "s": 4.763, "e": 4.83, "line": 2}, {"w": "یکی", "s": 4.999, "e": 5.19