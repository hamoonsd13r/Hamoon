{"total": 173.14, "segs": [{"n": 1, "start": 0.0, "end": 1.95, "text": "توی این شهر، نامه‌ها شب میان."}, {"n": 2, "start": 2.233, "end": 5.434, "text": "نه قبض، نه کارت تبریک... فقط یه پاکتِ سیاه."}, {"n": 3, "start": 5.692, "end": 8.229, "text": "و توش یه تاریخ: آخرین روزِ زندگیت."}, {"n": 4, "start": 8.639, "end": 12.027, "text": "آخه نامه‌رسونِ شب فقط می‌تونه نامه رو بندازه توی صندوقِ پست."}, {"n": 5, "start": 12.265, "end": 14.274, "text": "صندوق نداشته باشی، نامه هم نداری."}, {"n": 6, "start": 14.513, "end": 18.211, "text": "ولی هر نامه‌ای که بیفته توی کیفش، باید برسونه. تک‌تکشون."}, {"n": 7, "start": 18.45, "end": 21.196, "text": "واسه همین توی شهرِ ما هیچ‌کس صندوقِ پست نداره."}, {"n": 8, "start": 21.435, "end": 23.751, "text": "پیتزافروش‌ها پیتزا رو از روی دیوار پرت می‌کنن."}, {"n": 9, "start": 23.99, "end": 28.103, "text": "آقای حبیبی صندوقش رو چهل سال پیش جوش داد. الان صد و چهار سالشه."}, {"n": 10, "start": 28.342, "end": 30.676, "text": "اسمِ من آرینه، و من یه استعداد دارم."}, {"n": 11, "start": 30.915, "end": 32.647, "text": "هر دست‌خطی رو می‌تونم کپی کنم."}, {"n": 12, "start": 32.886, "end": 34.19, "text": "امضای مامان روی کارنامه‌م."}, {"n": 13, "start": 34.437, "end": 36.883, "text": "تا حالا هیچ‌کس مچم رو نگرفته بود... تا یه شب."}, {"n": 14, "start": 37.299, "end": 39.638, "text": "خواهر کوچیکم، نیکا، شش سالش شد."}, {"n": 15, "start": 39.877, "end": 43.085, "text": "و با یه جعبه‌ی مقوایی برای خودش صندوقِ پست درست کرد."}, {"n": 16, "start": 43.324, "end": 45.342, "text": "با یه پرچمِ قرمز و کلی اکلیل."}, {"n": 17, "start": 45.581, "end": 47.304, "text": "صبح، توش یه پاکتِ سیاه بود."}, {"n": 18, "start": 47.543, "end": 49.243, "text": "با یه دست‌خطِ پیچ‌پیچیِ بی‌نقص:"}, {"n": 19, "start": 49.847, "end": 51.213, "text": "«نیکا. ششم آبان.»"}, {"n": 20, "start": 51.452, "end": 52.045, "text": "یعنی فردا."}, {"n": 21, "start": 52.045, "end": 54.058, "text": "نامه رسیده بود. دیر شده بود."}, {"n": 22, "start": 54.297, "end": 56.145, "text": "بابابزرگ تا دیدش رنگش پرید."}, {"n": 23, "start": 56.384, "end": 61.307, "text": "آروم گفت: «هر نامه‌ای که توی کیفش باشه، باید برسونه. حتی اونایی که خودش ننوشته.»"}, {"n": 24, "start": 61.615, "end": 64.776, "text": "ساعتِ ده و نیم شب، رفتم روی پشت‌بوم و منتظر موندم."}, {"n": 25, "start": 65.015, "end": 66.825, "text": "جیرجیر... جیرجیر... تاپ."}, {"n": 26, "start": 67.063, "end": 71.973, "text": "یه گاریِ نامه داشت توی خیابونِ خالی می‌اومد. و کسی که هلش می‌داد... نامه‌رسونِ شب بود."}, {"n": 27, "start": 72.212, "end": 75.03, "text": "دو متر قد. لباسِ فرمِ آبی. کلاهش پایین."}, {"n": 28, "start": 75.275, "end": 77.384, "text": "و جای دهنش... یه شکافِ نامه بود."}, {"n": 29, "start": 77.623, "end": 78.292, "text": "تق، تق."}, {"n": 30, "start": 78.663, "end": 82.585, "text": "با دوچرخه دنبالش رفتم. تا اداره‌ی پستِ قدیمی که سال‌هاست بسته‌ست."}, {"n": 31, "start": 82.824, "end": 85.081, "text": "رفت تو... و رفت پایین، توی زیرزمین."}, {"n": 32, "start": 85.32, "end": 89.761, "text": "کلِ زیرزمین یه دیوار بود پر از جانامه‌ایِ ریز. هزارتا هزارتا."}, {"n": 33, "start": 90.0, "end": 94.546, "text": "روی هر کدوم یه اسم بود. معلمم. پیتزافروش. مامان. بابا. من."}, {"n": 34, "start": 94.834, "end": 99.226, "text": "یه دستگاهِ مهرِ غول‌پیکر، تق‌تق، روی پاکت‌های سیاه تاریخ می‌زد."}, {"n": 35, "start": 99.465, "end": 103.427, "text": "و روی میز، یه قلمِ پر. قلمی که همه‌ی تاریخ‌های شهر رو نوشته بود."}, {"n": 36, "start": 103.666, "end": 105.288, "text": "ساعتِ یازده و چهل دقیقه."}, {"n": 37, "start": 105.527, "end": 109.797, "text": "قلم رو برداشتم... و بهترین جعلِ عمرم رو نوشتم. همون دست‌خطِ پیچ‌پیچی."}, {"n": 38, "start": 110.036, "end": 112.711, "text": "روی پاکت نوشتم: «نامه‌رسونِ شب. امروز.»"}, {"n": 39, "start": 112.95, "end": 116.609, "text": "یازده و پنجاه و پنج. جیرجیر... جیرجیر... داشت برمی‌گشت."}, {"n": 40, "start": 116.848, "end": 119.847, "text": "پاکت رو انداختم توی کیفش و پشتِ دستگاهِ مهر قایم شدم."}, {"n": 41, "start": 120.086, "end": 122.649, "text": "وایساد. دست کرد توی کیف. نامه‌ی من رو درآورد."}, {"n": 42, "start": 122.888, "end": 125.338, "text": "شکافِ دهنش صدا داد: تق، تق، تق."}, {"n": 43, "start": 125.577, "end": 128.877, "text": "برگشت... و درست به دستگاهِ مهر نگاه کرد. درست به من."}, {"n": 44, "start": 129.116, "end": 132.641, "text": "ولی اون باید هر نامه‌ای رو برسونه. حتی اونایی که خودش ننوشته."}, {"n": 45, "start": 132.88, "end": 134.461, "text": "یازده و پنجاه و نه."}, {"n": 46, "start": 134.461, "end": 137.065, "text": "پاکت رو برد بالا... و انداختش توی شکافِ دهنِ خودش."}, {"n": 47, "start": 137.08, "end": 137.6, "text": "تق."}, {"n": 48, "start": 137.9, "end": 141.999, "text": "نامه‌رسونِ شب تا شد. مثلِ کاغذ. کوچیک‌تر. صاف‌تر."}, {"n": 49, "start": 141.999, "end": 145.698, "text": "تا جایی که فقط یه پاکتِ سیاه روی زمین موند. دربسته."}, {"n": 50, "start": 146.001, "end": 148.014, "text": "نیمه‌شب، نامه‌ی نیکا رو پاره کردم."}, {"n": 51, "start": 148.253, "end": 150.598, "text": "و سه هزار و چهارصد و دوازده تای دیگه."}, {"n": 52, "start": 150.837, "end": 153.195, "text": "فقط یه چیز موند. کیفش. کلاهش."}, {"n": 53, "start": 153.434, "end": 156.004, "text": "و یه شهر که هنوز نامه‌هاش رو لازم داشت."}, {"n": 54, "start": 156.243, "end": 158.435, "text": "واسه همین حالا... من نامه‌ها رو می‌رسونم."}, {"n": 55, "start": 158.674, "end": 161.943, "text": "شبی یه پاکت. و همه یه جمله رو می‌گن: «امروز نه.»"}, {"n": 56, "start": 162.315, "end": 166.282, "text": "صندوق‌ها برگشتن. نیکا یه صندوقِ فلزی داره، با دو برابر اکلیل."}, {"n": 57, "start": 166.521, "end": 170.216, "text": "و من هنوز شبی یه نامه می‌رسونم."}, {"n": 58, "start": 170.216, "end": 171.268, "text": "نامه‌ی امشب... برای همه‌ی کسایی که لایک نکردن."}, {"n": 59, "start": 171.507, "end": 172.853, "text": "صندوقِ پستت رو چک کن."}], "words": [{"w": "توی", "s": 0.0, "e": 0.195, "line": 1}, {"w": "این", "s": 0.195, "e": 0.389, "line": 1}, {"w": "شهر،", "s": 0.389, "e": 0.78, "line": 1}, {"w": "نامه‌ها", "s": 0.78, "e": 1.327, "line": 1}, {"w": "شب", "s": 1.327, "e": 1.699, "line": 1}, {"w":