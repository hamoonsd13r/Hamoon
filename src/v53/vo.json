{"total": 175.326, "segs": [{"n": 1, "start": 0.0, "end": 3.537, "text": "تا حالا شده احساس کنی همه‌چیز داره از کنترلت خارج می‌شه؟"}, {"n": 2, "start": 4.297, "end": 5.588, "text": "قلبت تندتر می‌زنه،"}, {"n": 3, "start": 5.977, "end": 8.014, "text": "ذهنت پر از فکرهای مختلف می‌شه،"}, {"n": 4, "start": 8.014, "end": 11.361, "text": "و هر چقدر بیشتر تلاش می‌کنی همه‌چیز رو درست کنی،"}, {"n": 5, "start": 11.781, "end": 13.25, "text": "انگار اوضاع بدتر می‌شه."}, {"n": 6, "start": 14.024, "end": 16.007, "text": "آب‌وهوا، رفتار آدم‌ها،"}, {"n": 7, "start": 16.337, "end": 20.175, "text": "اتفاقات گذشته، و حتی آینده‌ای که هنوز از راه نرسیده؛"}, {"n": 8, "start": 20.661, "end": 23.833, "text": "تو نمی‌تونی هیچ‌کدوم از این‌ها رو به‌طور کامل کنترل کنی."}, {"n": 9, "start": 24.715, "end": 27.575, "text": "اما بیشتر آدم‌ها تمام زندگی‌شون رو"}, {"n": 10, "start": 27.575, "end": 30.538, "text": "صرف تلاش برای کنترل همین چیزها می‌کنن."}, {"n": 11, "start": 31.352, "end": 34.463, "text": "اینجاست که یه فلسفه‌ی قدیمی وارد داستان می‌شه:"}, {"n": 12, "start": 34.852, "end": 36.993, "text": "فلسفه‌ای به اسم رواقی‌گری."}, {"n": 13, "start": 37.962, "end": 40.641, "text": "رواقی‌ها به یه حقیقت ساده باور داشتن:"}, {"n": 14, "start": 41.048, "end": 43.302, "text": "تو نمی‌تونی توفان رو متوقف کنی،"}, {"n": 15, "start": 43.652, "end": 47.67, "text": "اما می‌تونی انتخاب کنی که وسط توفان چطور بایستی."}, {"n": 16, "start": 48.838, "end": 52.175, "text": "فرض کن دو نفر دقیقاً توی یک شرایط زندگی می‌کنن."}, {"n": 17, "start": 52.564, "end": 54.288, "text": "هر دو با مشکلات روبه‌رو می‌شن،"}, {"n": 18, "start": 54.606, "end": 58.496, "text": "هر دو شکست می‌خورن، و هر دو روزهای سختی رو تجربه می‌کنن."}, {"n": 19, "start": 58.885, "end": 61.433, "text": "اما یه تفاوت بزرگ بینشون وجود داره."}, {"n": 20, "start": 62.235, "end": 66.552, "text": "نفر اول اجازه می‌ده هر اتفاق کوچیکی حالش رو خراب کنه."}, {"n": 21, "start": 66.958, "end": 69.501, "text": "یکی بهش بی‌احترامی می‌کنه، عصبانی می‌شه."}, {"n": 22, "start": 69.954, "end": 72.855, "text": "اتوبوس رو از دست می‌ده، تمام روزش خراب می‌شه."}, {"n": 23, "start": 73.288, "end": 76.837, "text": "توی کارش شکست می‌خوره، خودش رو یه آدم بازنده می‌دونه."}, {"n": 24, "start": 77.82, "end": 80.595, "text": "اما نفر دوم نگاه متفاوتی داره."}, {"n": 25, "start": 81.004, "end": 83.5, "text": "اون هم ناراحت می‌شه، اون هم گاهی می‌ترسه،"}, {"n": 26, "start": 83.895, "end": 88.183, "text": "اما یاد گرفته قبل از واکنش نشون دادن، یه لحظه مکث کنه."}, {"n": 27, "start": 88.571, "end": 91.035, "text": "چون فهمیده همه‌چیز دست اون نیست."}, {"n": 28, "start": 91.906, "end": 93.929, "text": "بعضی چیزها از کنترل ما خارجن؛"}, {"n": 29, "start": 94.414, "end": 97.797, "text": "مثل گذشته، نظر دیگران، رفتار آدم‌ها،"}, {"n": 30, "start": 97.797, "end": 100.446, "text": "و اتفاقاتی که بدون اجازه‌ی ما رخ می‌دن."}, {"n": 31, "start": 101.172, "end": 104.034, "text": "اما یه چیز همیشه می‌تونه دست خودمون باشه:"}, {"n": 32, "start": 104.437, "end": 107.626, "text": "اینکه چطور به اون اتفاقات واکنش نشون بدیم."}, {"n": 33, "start": 108.573, "end": 112.948, "text": "وقتی کسی بهت توهین می‌کنه، مجبور نیستی جوابش رو با عصبانیت بدی."}, {"n": 34, "start": 113.379, "end": 116.429, "text": "وقتی شکست می‌خوری، مجبور نیستی تسلیم بشی."}, {"n": 35, "start": 116.852, "end": 122.022, "text": "و وقتی زندگی طبق برنامه‌ت پیش نمی‌ره، مجبور نیستی با تمام دنیا بجنگی."}, {"n": 36, "start": 123.036, "end": 127.788, "text": "البته گفتنش آسونه؛ چون ذهن تو همیشه سعی می‌کنه تحریکت کنه."}, {"n": 37, "start": 128.207, "end": 132.528, "text": "بهت می‌گه: «عصبانی شو، جوابش رو بده، ثابت کن که حق با توئه.»"}, {"n": 38, "start": 133.03, "end": 135.917, "text": "اما هر بار که بدون فکر واکنش نشون می‌دی،"}, {"n": 39, "start": 135.917, "end": 139.546, "text": "اختیار آرامشت رو به اتفاقات بیرونی می‌سپری."}, {"n": 40, "start": 140.58, "end": 143.814, "text": "قدرت واقعی این نیست که بتونی همه رو شکست بدی."}, {"n": 41, "start": 144.235, "end": 149.11, "text": "قدرت واقعی اینه که وقتی عصبانی هستی، بتونی خودت رو کنترل کنی."}, {"n": 42, "start": 150.359, "end": 154.425, "text": "شاید فردا دوباره شکست بخوری، شاید کسی بهت احترام نذاره،"}, {"n": 43, "start": 154.814, "end": 157.48, "text": "شاید هیچ‌چیز اون‌طوری که می‌خواستی پیش نره."}, {"n": 44, "start": 158.192, "end": 163.134, "text": "اما یادت باشه: قرار نیست همیشه دنیا مطابق میل تو تغییر کنه."}, {"n": 45, "start": 163.563, "end": 166.589, "text": "گاهی این تویی که باید نگاهت رو تغییر بدی."}, {"n": 46, "start": 167.473, "end": 171.47, "text": "چون آرامش واقعی از کنترل کردن دنیا به دست نمیاد؛"}, {"n": 47, "start": 172.174, "end": 175.002, "text": "از کنترل کردن واکنش خودت شروع می‌شه."}], "words": [{"w": "تا", "s": 0.0, "e": 0.148, "line": 1}, {"w": "حالا", "s": 0.148, "e": 0.37, "line": 1}, {"w": "شده", "s": 0.37, "e": 0.593, "line": 1}, {"w": "احساس", "s": 0.593, "e": 0.963, "line": 1}, {"w": "کنی", "s": 0.963, "e": 1.204, "line": 1}, {"w": "همه‌چیز", "s": 1.204, "e": 1.833, "line": 1}, {"w": "داره", "s": 1.833, "e": 2.074, "line": 1}, {"w": "از", "s": 2.074, "e": 2.204, "line": 1}, {"w": "کنترلت", "s": 2.204, "e": 2.741, "line": 1}, {"w": "خارج", "s": 2.741, "e": 3.074, "line": 1}, {"w": "می‌شه؟", "s": 3.074, "e": 3.537, "line": 1}, {"w": "قلبت", "s": 4.297, "e": 4.597, "line": 2}, {"w": "تندتر", "s": 4.597, "e": 5.097, "line": 2}, {"w": "می‌زنه،", "s": 5.097, "e": 5.588, "line": 2}, {"w": "ذهنت", "s": 5.977, "e": 6.422, "line": 3}, {"w": "پر", "s": 6.422, "e": 6.7, "line": 3}, {"w": "از", "s": 6.7, "e": 6.885, "line": 3}, {"w": "فکرهای", "s": 6.885, "e": 7.237, "line": 3}, {"w": "مختلف", "s": 7.237, "e": 7.681, "line": 3}, {"w": "می‌شه،", "s": 7.681, "e": 8.014, "line": 3}, {"w": "و", "s": 8.014, "e": 8.088, "line": 4}, {"w": "هر", "s": 8.477, "e": 8.657, "line": 4}, {"w": "چقدر", "s": 8.657, "e": 8.991, "line": 4}, {"w": "بیشتر", "s": 8.991, "e": 9.472, "line": 4}, {"w": "تلاش", "s": 9.472, "e": 9.731, "line": 4}, {"w": "می‌کنی", "s": 9.731, "e": 10.12, "line": 4}, {"w": "همه‌چیز", "s": 10.12, "e": 10.62, "