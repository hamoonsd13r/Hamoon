{"total": 29.098, "segs": [{"n": 1, "src": 1, "start": 0.1, "end": 3.637, "text": "تا حالا شده احساس کنی همه‌چیز داره از کنترلت خارج می‌شه؟"}, {"n": 2, "src": 14, "start": 4.407, "end": 6.661, "text": "تو نمی‌تونی توفان رو متوقف کنی،"}, {"n": 3, "src": 15, "start": 7.011, "end": 11.029, "text": "اما می‌تونی انتخاب کنی که وسط توفان چطور بایستی."}, {"n": 4, "src": 40, "start": 11.899, "end": 15.133, "text": "قدرت واقعی این نیست که بتونی همه رو شکست بدی."}, {"n": 5, "src": 41, "start": 15.554, "end": 20.429, "text": "قدرت واقعی اینه که وقتی عصبانی هستی، بتونی خودت رو کنترل کنی."}, {"n": 6, "src": 46, "start": 21.349, "end": 25.346, "text": "چون آرامش واقعی از کنترل کردن دنیا به دست نمیاد؛"}, {"n": 7, "src": 47, "start": 26.05, "end": 28.878, "text": "از کنترل کردن واکنش خودت شروع می‌شه."}], "words": [{"w": "تا", "s": 0.1, "e": 0.248, "line": 1, "src": 1}, {"w": "حالا", "s": 0.248, "e": 0.47, "line": 1, "src": 1}, {"w": "شده", "s": 0.47, "e": 0.693, "line": 1, "src": 1}, {"w": "احساس", "s": 0.693, "e": 1.063, "line": 1, "src": 1}, {"w": "کنی", "s": 1.063, "e": 1.304, "line": 1, "src": 1}, {"w": "همه‌چیز", "s": 1.304, "e": 1.933, "line": 1, "src": 1}, {"w": "داره", "s": 1.933, "e": 2.174, "line": 1, "src": 1}, {"w": "از", "s": 2.174, "e": 2.304, "line": 1, "src": 1}, {"w": "کنترلت", "s": 2.304, "e": 2.841, "line": 1, "src": 1}, {"w": "خارج", "s": 2.841, "e": 3.174, "line": 1, "src": 1}, {"w": "می‌شه؟", "s": 3.174, "e": 3.637, "line": 1, "src": 1}, {"w": "تو", "s": 4.407, "e": 4.567, "line": 2, "src": 14}, {"w": "نمی‌تونی", "s": 4.567, "e": 5.215, "line": 2, "src": 14}, {"w": "توفان", "s": 5.215, "e": 5.641, "line": 2, "src": 14}, {"w": "رو", "s": 5.641, "e": 5.826, "line": 2, "src": 14}, {"w": "متوقف", "s": 5.826, "e": 6.326, "line": 2, "src": 14}, {"w": "کنی،", "s": 6.326, "e": 6.661, "line": 2, "src": 14}, {"w": "اما", "s": 7.011, "e": 7.307, "line": 3, "src": 15}, {"w": "می‌تونی", "s": 7.307, "e": 7.789, "line": 3, "src": 15}, {"w": "انتخاب", "s": 7.789, "e": 8.344, "