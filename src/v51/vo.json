{"total": 147.697, "segs": [{"n": 1, "start": 0.0, "end": 3.056, "text": "شهوت، همیشه با یک فاجعه شروع نمی‌شه."}, {"n": 2, "start": 3.445, "end": 5.72, "text": "گاهی فقط با یک نگاه شروع می‌شه…"}, {"n": 3, "start": 6.109, "end": 8.699, "text": "یک کنجکاوی کوتاه، یه لحظه ضعف،"}, {"n": 4, "start": 9.088, "end": 12.998, "text": "و یه تصمیم کوچیک که فکر می‌کنی اصلاً مهم نیست."}, {"n": 5, "start": 13.387, "end": 18.789, "text": "اما همون تصمیم کوچیک می‌تونه آروم‌آروم کنترل زندگیت رو ازت بگیره."}, {"n": 6, "start": 19.894, "end": 21.585, "text": "اولش فقط چند دقیقه‌ست."}, {"n": 7, "start": 21.983, "end": 23.92, "text": "بعد تبدیل می‌شه به یه عادت،"}, {"n": 8, "start": 24.309, "end": 28.787, "text": "و بعد به چیزی تبدیل می‌شه که ذهنت مدام بهش فکر می‌کنه؛"}, {"n": 9, "start": 29.176, "end": 30.485, "text": "حتی وقتی توی مدرسه‌ای،"}, {"n": 10, "start": 30.874, "end": 32.92, "text": "حتی وقتی کنار خانواده نشستی،"}, {"n": 11, "start": 33.309, "end": 35.856, "text": "حتی وقتی باید روی آینده‌ت تمرکز کنی."}, {"n": 12, "start": 36.245, "end": 39.834, "text": "یه تصویر، یه فکر، یه خواسته‌ی ناگهانی،"}, {"n": 13, "start": 40.223, "end": 42.878, "text": "و دوباره همه‌چیز از دستت خارج می‌شه."}, {"n": 14, "start": 44.007, "end": 48.215, "text": "اما ترسناک‌ترین قسمت ماجرا این نیست که تو چیزی رو می‌خوای؛"}, {"n": 15, "start": 48.604, "end": 53.984, "text": "ترسناک‌ترین قسمت اینه که کم‌کم احساس می‌کنی دیگه نمی‌تونی جلوش رو بگیری."}, {"n": 16, "start": 54.373, "end": 55.746, "text": "تمرکزت کمتر می‌شه،"}, {"n": 17, "start": 56.135, "end": 58.157, "text": "کارهای مهم رو عقب می‌اندازی،"}, {"n": 18, "start": 58.543, "end": 62.233, "text": "ساعت‌ها از عمرت می‌گذره بدون اینکه متوجه بشی."}, {"n": 19, "start": 63.131, "end": 69.006, "text": "و چیزی که قرار بود فقط چند دقیقه لذت باشه، تبدیل می‌شه به یه زنجیر نامرئی؛"}, {"n": 20, "start": 69.395, "end": 74.69, "text": "زنجیری که وقتت رو می‌گیره، انرژیت رو می‌گیره، اعتماد به نفست رو می‌گیره،"}, {"n": 21, "start": 75.079, "end": 78.513, "text": "و آروم‌آروم تو رو از زندگی واقعی دور می‌کنه؛"}, {"n": 22, "start": 78.902, "end": 83.854, "text": "از دوستات، از هدف‌هات، از آینده‌ای که همیشه آرزوش رو داشتی."}, {"n": 23, "start": 84.243, "end": 88.47, "text": "و هر بار که دوباره تسلیم می‌شی، به خودت می‌گی: «این آخرین باره.»"}, {"n": 24, "start": 88.859, "end": 91.986, "text": "اما چند روز بعد، دوباره همه‌چیز تکرار می‌شه."}, {"n": 25, "start": 92.837, "end": 95.656, "text": "و تو می‌مونی با همون احساس پشیمونی،"}, {"n": 26, "start": 96.045, "end": 97.741, "text": "همون قول‌های شکسته،"}, {"n": 27, "start": 98.197, "end": 100.932, "text": "و همون سؤالی که بارها از خودت پرسیدی:"}, {"n": 28, "start": 101.321, "end": 103.117, "text": "«چرا نمی‌تونم متوقفش کنم؟»"}, {"n": 29, "start": 104.756, "end": 106.916, "text": "اما یه حقیقت مهم وجود داره:"}, {"n": 30, "start": 107.305, "end": 111.353, "text": "داشتن میل و خواسته، به معنی ضعیف بودن تو نیست."}, {"n": 31, "start": 111.742, "end": 116.862, "text": "مشکل از جایی شروع می‌شه که اجازه می‌دی یه عادت به جای تو تصمیم بگیره."}, {"n": 32, "start": 117.945, "end": 123.587, "text": "و تغییر از همون لحظه‌ای شروع می‌شه که تصمیم می‌گیری کنترل زندگیت رو پس بگیری."}, {"n": 33, "start": 124.531, "end": 126.363, "text": "نه فردا، نه هفته‌ی بعد،"}, {"n": 34, "start": 126.707, "end": 127.668, "text": "همین امروز."}, {"n": 35, "start": 128.975, "end": 133.225, "text": "چون آزادی واقعی این نیست که هر کاری دلت خواست انجام بدی؛"}, {"n": 36, "start": 133.614, "end": 139.67, "text": "آزادی واقعی اینه که بتونی چیزی رو بخوای، اما خودت تصمیم بگیری که انجامش ندی."}, {"n": 37, "start": 140.985, "end": 141.628, "text": "یادت باشه،"}, {"n": 38, "start": 142.017, "end": 144.505, "text": "تو قرار نیست برده‌ی خواسته‌هات باشی."}, {"n": 39, "start": 144.824, "end": 147.373, "text": "این تویی که باید زندگیت رو کنترل کنی."}], "words": [{"w": "شهوت،", "s": 0.0, "e": 0.444, "line": 1}, {"w": "همیشه", "s": 0.931, "e": 1.215, "line": 1}, {"w": "با", "s": 1.215, "e": 1.4, "line": 1}, {"w": "یک", "s": 1.4, "e": 1.585, "