{"total": 67.884, "segs": [{"n": 1, "start": 0.0, "end": 3.63, "text": "از وقتی آرش بچه بود، می‌تونست از هر چیزی رد بشه."}, {"n": 2, "start": 4.202, "end": 6.985, "text": "دیوار، درِ قفل‌شده... حتی آدم‌ها."}, {"n": 3, "start": 7.281, "end": 10.021, "text": "اولش فکر می‌کرد این باحال‌ترین قدرتِ دنیاست."}, {"n": 4, "start": 10.343, "end": 11.981, "text": "هیچ‌وقت پشتِ درِ خونه نمی‌موند."}, {"n": 5, "start": 12.299, "end": 13.725, "text": "همه‌ی قایم‌باشک‌ها رو می‌برد."}, {"n": 6, "start": 13.99, "end": 15.489, "text": "هیچی نمی‌تونست جلوش رو بگیره."}, {"n": 7, "start": 16.01, "end": 22.6, "text": "بزرگ‌تر که شد، یاد گرفت کامل کنترلش کنه. دقیقاً انتخاب می‌کرد از چی رد بشه و به چی دست نزنه."}, {"n": 8, "start": 23.211, "end": 26.569, "text": "تا اینکه یه روز صبح، مامان و باباش زودتر از همیشه بیدارش کردن."}, {"n": 9, "start": 26.819, "end": 28.122, "text": "هیچ‌کدوم لبخند نمی‌زدن."}, {"n": 10, "start": 28.603, "end": 30.56, "text": "آروم بهش گفتن سوارِ ماشین شو."}, {"n": 11, "start": 30.81, "end": 33.474, "text": "کلِ راه، هیچ‌کس یه کلمه هم حرف نزد."}, {"n": 12, "start": 34.013, "end": 36.789, "text": "آرش سعی کرد شوخی کنه. پرسید داریم کجا می‌ریم."}, {"n": 13, "start": 37.039, "end": 38.811, "text": "حتی پرسید: «کار بدی کردم؟»"}, {"n": 14, "start": 38.811, "end": 42.411, "text": "مامان و باباش هیچ جوابی ندادن. فقط زل زده بودن به جلو."}, {"n": 15, "start": 42.663, "end": 44.607, "text": "این سکوت دلش رو آشوب کرد."}, {"n": 16, "start": 45.134, "end": 49.041, "text": "آخرش جلوی یه ساختمونِ بزرگ نگه داشتن، که آرش تا حالا ندیده بود."}, {"n": 17, "start": 49.291, "end": 52.262, "text": "آدم‌های دیگه، آروم و سیاه‌پوش، می‌رفتن تو."}, {"n": 18, "start": 52.512, "end": 55.064, "text": "مامان و باباش پیاده شدن... آرش هم دنبالشون رفت."}, {"n": 19, "start": 55.526, "end": 56.026, "text": "رفتن تو."}, {"n": 20, "start": 56.592, "end": 59.331, "text": "آرش دور و برش رو نگاه کرد... و خشکش زد."}, {"n": 21, "start": 59.951, "end": 62.974, "text": "جلوی سالن، یه تابوت بود. و عکسِ خودش."}, {"n": 22, "start": 63.698, "end": 65.563, "text": "اون هیچ‌وقت از دیوارها رد نمی‌شد..."}, {"n": 23, "start": 66.223, "end": 67.592, "text": "اون از اول یه روح بود."}], "words": [{"w": "از", "s": 0.0, "e": 0.185, "line": 1}, {"w": "وقتی", "s": 0.185, "e": 0.481, "line": 1}, {"w": "آرش", "s": 0.481, "e": 0.741, "line": 1}, {"w": "بچه", "s": 0.741, "e": 1.148, "line": 1}, {"w": "بود،", "s": 1.148, "e": 1.463, "line": 1}, {"w": "می‌تونست", "s": 1.722, "e": 2.074, "line": 1}, {"w": "از", "s": 2.074, "e": 2.315, "line": 1}, {"w": "هر", "s": 2.315, "e": 2.593, "line": 1}, {"w": "چیزی", "s": 2.593, "e": 3.111, "line": 1}, {"w": "رد", "s": 3.111, "e": 3.296, "line": 1}, {"w": "بشه.", "s": 3.296, "e": 3.63, "line": 1}, {"w": "دیوار،", "s": 4.202, "e": 4.587, "line": 2}, {"w": "درِ", "s": 4.794, "e": 4.905, "line": 2}, {"w": "قفل‌شده...", "s": 4.905, "e": 5.791, "line": 2}, {"w": "حتی", "s": 5.976, "e": 6.319, "line": 2}, {"w": "آدم‌ها.", "s": 6.319, "e": 6.985, "line": 2}, {"w": "اولش", "s": 7.281, "e": 7.614, "line": 3}, {"w": "فکر", "s": 7.614, "e": 7.799, "line": 3}, {"w": "می‌کرد", "s": 7.799, "e": 8.095, "line": 3}, {"w": "این", "s": 8.095, "e": 8.225, "line": 3}, {"w": "باحال‌ترین", "s": 8.225, "e": 9.003, "line": 3}, {"w": "قدرتِ", "s": 9.003, "e": 9.41, "line": 3}, {"w": "دنیاست.", "s": 9.41, "e": 10.021, "line": 3}, {"w": "هیچ‌وقت", "s": 10.343, "e": 10.838, "line": 4}, {"w": "پشتِ", "s": 10.838, "e": 11.12, "line": 4}, {"w": "درِ", "s": 11.12, "e": 11.287, "line": 4}, {"w": "خونه", "s": 11.287, "e": 11.583, "line": 4}, {"w": "نمی‌موند.", "s": 11.583, "e": 11.981, "line": 4}, {"w": "همه‌ی", "s": 12.299, "e": 12.666, "line": 5}, {"w": "قایم‌باشک‌ها", "s": 12.666, "e": 13.474, "line": 5}, {"w": "رو", "s": 13.474, "e": 13.694, "line": 5}, {"w": "می‌برد.", "s": 13.694, "e": 13.725, "line": 5}, {"w": "هیچی", "s": 13.99, "e": 14.357, "line": 6}, {"w": "نمی‌تونست", "s": 14.357, "e": 14.783, "line": 6}, {"w": "جلوش", "s": 14.783, "e": 15.08, "line": 6}, {"w": "رو", "s": 15.0