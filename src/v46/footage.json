 },
 "shots": {
  "s01": {
   "t0": 0.091,
   "t1": 4.792,
   "text": "ساعت ۷:۱۶ دقیقه صبح، 27 نوامبر 1989."
  },
  "s02": {
   "t0": 5.246,
   "t1": 10.999,
   "text": "یه هواپیمای مسافربری چند دقیقه بعد از بلند شدن از فرودگاه بوگوتا در آسمون منفجر شد."
  },
  "s03": {
   "t0": 11.453,
   "t1": 13.323,
   "text": "107 نفر جونشون رو از دست دادن."
  },
  "s04": {
   "t0": 13.722,
   "t1": 20.02,
   "text": "این حادثه بعدها در پرونده‌های قضایی به شبکه جنایی یکی از معروف‌ترین قاچاقچی‌های تاریخ نسبت داده شد."
  },
  "s05": {
   "t0": 20.474,
   "t1": 21.418,
   "text": "پابلو اسکوبار."
  },
  "s06": {
   "t0": 21.872,
   "t1": 28.514,
   "text": "اما این مرد چطور از یه خانواده معمولی به کسی تبدیل شد که دولت کلمبیا سال‌ها برای متوقف کردنش جنگید؟"
  },
  "s07": {
   "t0": 28.968,
   "t1": 35.702,
   "text": "یکم دسامبر 1949، شهر ریونیگرو، کلمبیا، پابلو امیلیو اسکوبار گاویریا به دنیا اومد."
  },
  "s08": {
   "t0": 36.065,
   "t1": 38.134,
   "text": "مادرش معلم بود و پدرش کشاورز."
  },
  "s09": {
   "t0": 38.515,
   "t1": 42.055,
   "text": "خانواده‌ش بعدها به انویگادو نزدیک مدلین نقل مکان کردن."
  },
  "s10": {
   "t0": 42.381,
   "t1": 48.28,
   "text": "هیچکس اون موقع نمی‌دونست این پسربچه قراره به یکی از بدنام‌ترین چهره‌های قرن بیستم تبدیل بشه."
  },
  "s11": {
   "t0": 48.734,
   "t1": 51.112,
   "text": "پابلو از جوونی وارد کارهای غیرقانونی شد."
  },
  "s12": {
   "t0": 51.42,
   "t1": 54.488,
   "text": "سرقت خودرو، قاچاق کالا و معامله‌های خلاف."
  },
  "s13": {
   "t0": 54.833,
   "t1": 58.173,
   "text": "اما نقطه عطف زندگیش دهه 1970 بود."
  },
  "s14": {
   "t0": 58.481,
   "t1": 61.966,
   "text": "زمانی که بازار کوکائین در آمریکا به شدت گسترش پیدا کرد."
  },
  "s15": {
   "t0": 62.42,
   "t1": 66.613,
   "text": "سال 1976، پابلو به اتهام حمل کوکائین بازداشت شد."
  },
  "s16": {
   "t0": 66.958,
   "t1": 69.789,
   "text": "اما این اتفاق جلوی گسترش فعالیتش رو نگرفت."
  },
  "s17": {
   "t0": 70.098,
   "t1": 74.998,
   "text": "اون همراه چند قاچاقچی دیگه شبکه‌ای ساخت که بعدها به اسم کارتل مدلین شناخته شد."
  },
  "s18": {
   "t0": 75.325,
   "t1": 82.132,
   "text": "شبکه‌ای که درآمدش به رقم‌های نجومی رسید و اسم پابلو وارد فهرست ثروتمندترین آدم‌های جهان شد."
  },
  "s19": {
   "t0": 82.585,
   "t1": 86.179,
   "text": "اما پابلو فقط پول نمی‌خواست، قدرت سیاسی هم می‌خواست."
  },
  "s20": {
   "t0": 86.56,
   "t1": 91.752,
   "text": "سال 1982، اون حتی به عنوان نماینده علی‌البدل وارد کنگره کلمبیا شد."
  },
  "s21": {
   "t0": 92.024,
   "t1": 97.796,
   "text": "در محله‌های فقیرنشین برای بعضی خانواده‌ها خونه می‌ساخت و تلاش می‌کرد خودش رو حامی مردم نشون بده."
  },
  "s22": {
   "t0": 98.104,
   "t1": 101.843,
   "text": "ولی پشت این تصویر یه شبکه قاچاق و خشونت وجود داشت."
  },
  "s23": {
   "t0": 102.297,
   "t1": 108.196,
   "text": "30 آوریل 1984، رودریگو لارا بونیا، وزیر دادگستری کلمبیا ترور شد."
  },
  "s24": {
   "t0": 108.523,
   "t1": 110.937,
   "text": "وزیری که علیه نفوذ قاچاقچی‌ها ایستاده بود."
  },
  "s25": {
   "t0": 111.282,
   "t1": 116.69,
   "text": "این قتل که به شبکه اسکوبار نسبت داده شد، جنگ اون با حکومت رو وارد مرحله تازه‌ای کرد."
  },
  "s26": {
   "t0": 117.144,
   "t1": 123.134,
   "text": "و بعد رسیدیم به سال 1989، یکی از خونین‌ترین سال‌های تاریخ معاصر کلمبیا."
  },
  "s27": {
   "t0": 123.515,
   "t1": 127.689,
   "text": "18 اکتبر، لوئیس کارلوس گالان نامزد ریاست جمهوری ترور شد."
  },
  "s28": {
   "t0": 127.98,
   "t1": 131.646,
   "text": "27 نوامبر، پرواز 203 آویانکا سقوط کرد."
  },
  "s29": {
   "t0": 131.973,
   "t1": 139.379,
   "text": "107 نفر کشته شدن و ششم دسامبر یک انفجار بزرگ ساختمان سازمان امنیتی کلمبیا رو هدف قرار داد."
  },
  "s30": {
   "t0": 139.796,
   "t1": 145.132,
   "text": "کشوری که پابلو توش بزرگ شده بود، حالا با بمب‌گذاری، ترور و ترس دست و پنجه نرم می‌کرد."
  },
  "s31": {
   "t0": 145.459,
   "t1": 148.291,
   "text": "اما پایان قدرت اسکوبار شکل عجیبی داشت."
  },
  "s32": {
   "t0": 148.708,
   "t1": 155.133,
   "text": "19 ژوئن 1991، پابلو خودش رو تسلیم حکومت کرد، ولی نه برای رفتن به یه زندان معمولی."
  },
  "s33": {
   "t0": 155.551,
   "t1": 158.618,
   "text": "اون به زندانی رفت که طبق خواسته‌های خودش ساخته شده بود."
  },
  "s34": {
   "t0": 159.072,
   "t1": 162.666,
   "text": "اسمش لا کاتدرال، زندان اختصاصی پابلو اسکوبار."
  },
  "s35": {
   "t0": 163.12,
   "t1": 166.478,
   "text": "حتی از داخل همون زندان هم فعالیت‌های جنایی‌ش ادامه داشت."
  },
  "s36": {
   "t0": 166.932,
   "t1": 169.019,
   "text": "تا اینکه دولت تصمیم گرفت منتقلش کنه."
  },
  "s37": {
   "t0": 169.473,
   "t1": 175.735,
   "text": "22 ژوئیه 1992، پابلو فرار کرد و بزرگ‌ترین تعقیب زندگیش شروع شد."
  },
  "s38": {
   "t0": 176.188,
   "t1": 177.132,
   "text": "ماه‌ها گذشت."
  },
  "s39": {
   "t0": 177.532,
   "t1": 180.309,
   "text": "آدم‌های نزدیکش یکی یکی کشته یا دستگیر شدن."
  },
  "s40": {
   "t0": 180.744,
   "t1": 182.015,
   "text": "رقیب‌هاش به دنبالش بودن."
  },
  "s41": {
   "t0": 182.414,
   "t1": 185.028,
   "text": "پلیس هم شهر رو برای پیدا کردنش زیر نظر داشت."
  },
  "s42": {
   "t0": 185.427,
   "t1": 189.493,
   "text": "خانواده‌ش هم برای پیدا کردن جایی امن تلاش می‌کردن از کلمبیا خارج بشن."
  },
  "s43": {
   "t0": 189.947,
   "t1": 197.734,
   "text": "تا اینکه رسیدیم به پنجشنبه، دوم دسامبر 1993، فقط یک روز بعد از تولد 44 سالگی پابلو."
  },
  "s44": {
   "t0": 198.151,
   "t1": 201.473,
   "text": "اون در مخفیگاهش در شهر مدلین با پسرش تماس گرفت."
  },
  "s45": {
   "t0": 201.926,
   "t1": 204.504,
   "text": "اما این بار تماس بیش از اندازه طول کشید."
  },
  "s46": {
   "t0": 204.958,
   "t1": 208.588,
   "text": "پلیس با ردیابی ارتباط تلفنی محل مخفیگاه رو پیدا کرد."
  },
  "s47": {
   "t0": 208.933,
   "t1": 210.73,
   "text": "نیروهای ویژه وارد عملیات شدن."
  },
  "s48": {
   "t0": 211.129,
   "t1": 212.962,
   "text": "پابلو سعی کرد از پشت بام فرار کنه."
  },
  "s49": {
   "t0": 213.416,
   "t1": 219.714,
   "text": "صدای تیراندازی بلند شد و چند لحظه بعد پابلو اسکوبار روی پشت‌بام یکی از خونه‌ها کشته شد."
  },
  "s50": {
   "t0": 220.168,
   "t1": 224.597,
   "text": "درباره اینکه گلوله نهایی رو چه کسی شلیک کرد، روایت‌های متفاوتی وجود داره."
  },
  "s51": {
   "t0": 225.014,
   "t1": 226.285,
   "text": "اما یه حقیقت روشنه."
  },
  "s52": {
   "t0": 226.739,
   "t1": 238.301,
   "text": "مردی که با قاچاق مواد مخدر به ثروت و قدرت رسید، با خشونت شبکه‌ش زندگی هزاران نفر رو تحت تأثیر قرار داد و در 44 سالگی در جریان تعقیب پلیس کشته شد."
  },
  "s53": {
   "t0": 238.754,
   "t1": 246.741,
   "text": "پابلو اسکوبار مرد، اما زخم‌هایی که دوران کارتل‌های مواد مخدر روی کلمبیا گذاشت، با مرگ اون یک شبه از بین نرفت"
  }
 }
}