{"total": 109.905, "segs": [{"n": 1, "start": 0.0, "end": 3.778, "text": "می‌دونی بزرگ‌ترین دروغی که هر روز به خودت می‌گی چیه؟"}, {"n": 2, "start": 4.673, "end": 5.906, "text": "«از فردا شروع می‌کنم.»"}, {"n": 3, "start": 6.264, "end": 9.292, "text": "«فردا زود بیدار می‌شم، فردا ورزش می‌کنم،"}, {"n": 4, "start": 9.68, "end": 11.567, "text": "فردا زندگیم رو تغییر می‌دم.»"}, {"n": 5, "start": 12.299, "end": 15.857, "text": "اما فردا می‌رسه… و تو هنوز همون آدم دیروزی."}, {"n": 6, "start": 16.849, "end": 19.264, "text": "زنگ ساعت به صدا درمیاد، خاموشش می‌کنی؛"}, {"n": 7, "start": 19.653, "end": 20.928, "text": "«فقط پنج دقیقه‌ی دیگه…»"}, {"n": 8, "start": 20.928, "end": 23.555, "text": "و دوباره یه روز دیگه رو از دست می‌دی."}, {"n": 9, "start": 24.407, "end": 27.243, "text": "روزها می‌گذرن، هفته‌ها تبدیل به ماه می‌شن،"}, {"n": 10, "start": 27.243, "end": 31.177, "text": "و تو هنوز منتظری یه روز انگیزه‌ی کافی پیدا کنی."}, {"n": 11, "start": 32.028, "end": 33.976, "text": "اما یه حقیقت تلخ وجود داره:"}, {"n": 12, "start": 34.394, "end": 36.695, "text": "انگیزه همیشه همراهت نمی‌مونه."}, {"n": 13, "start": 37.093, "end": 40.065, "text": "بعضی روزها خسته‌ای، بعضی روزها حوصله نداری،"}, {"n": 14, "start": 40.454, "end": 43.54, "text": "بعضی روزها حتی دلت نمی‌خواد از تخت بلند بشی."}, {"n": 15, "start": 43.54, "end": 48.738, "text": "و دقیقاً همون روزهاست که شخصیت واقعی تو ساخته می‌شه."}, {"n": 16, "start": 50.002, "end": 52.866, "text": "یه روز جلوی آینه می‌ایستی، به خودت نگاه می‌کنی"}, {"n": 17, "start": 52.866, "end": 56.56, "text": "و از خودت می‌پرسی: «تا کِی قراره همین‌طوری ادامه بدم؟»"}, {"n": 18, "start": 57.782, "end": 59.611, "text": "همون لحظه یه تصمیم می‌گیری:"}, {"n": 19, "start": 60.019, "end": 61.728, "text": "دیگه منتظر فردا نمی‌مونی."}, {"n": 20, "start": 62.857, "end": 65.99, "text": "فردای اون روز، وقتی ساعت زنگ می‌زنه، بلند می‌شی."}, {"n": 21, "start": 66.4, "end": 69.597, "text": "حتی وقتی خسته‌ای، حتی وقتی ذهنت بهونه میاره."}, {"n": 22, "start": 70.285, "end": 72.603, "text": "شروع می‌کنی؛ نه با یه تغییر بزرگ،"}, {"n": 23, "start": 72.992, "end": 74.455, "text": "فقط با یه قدم کوچیک."}, {"n": 24, "start": 74.962, "end": 77.257, "text": "یه روز تلاش می‌کنی، بعد یه روز دیگه،"}, {"n": 25, "start": 77.666, "end": 79.099, "text": "و دوباره یه روز دیگه."}, {"n": 26, "start": 79.907, "end": 84.709, "text": "کم‌کم متوجه می‌شی که برای ادامه دادن، همیشه به انگیزه نیاز نداری،"}, {"n": 27, "start": 85.149, "end": 87.535, "text": "چون تو داری چیزی قدرتمندتر می‌سازی:"}, {"n": 28, "start": 88.508, "end": 88.981, "text": "انضباط."}, {"n": 29, "start": 90.49, "end": 92.539, "text": "و یه روز به پشت سرت نگاه می‌کنی؛"}, {"n": 30, "start": 92.927, "end": 96.759, "text": "به تمام اون روزهایی که می‌خواستی تسلیم بشی، اما نشدی."}, {"n": 31, "start": 97.552, "end": 102.767, "text": "اون وقت می‌فهمی زندگیت از روزی تغییر کرد که دیگه منتظر فردا نموندی."}, {"n": 32, "start": 103.806, "end": 107.167, "text": "چون فرق بین رویا و واقعیت فقط یه چیزه:"}, {"n": 33, "start": 107.88, "end": 109.581, "text": "کاری که امروز انجام می‌دی."}], "words": [{"w": "می‌دونی", "s": 0.0, "e": 0.352, "line": 1}, {"w": "بزرگ‌ترین", "s": 0.352, "e": 1.407, "line": 1}, {"w": "دروغی", "s": 1.407, "e": 1.889, "line": 1}, {"w": "که", "s": 1.889, "e": 2.093, "line": 1}, {"w": "هر", "s": 2.093, "e": 2.389, "line": 1}, {"w": "روز", "s": 2.389, "e": 2.611, "line": 1}, {"w": "به", "s": 2.611, "e": 2.759, "line": 1}, {"w": "خودت", "s": 2.759, "e": 3.037, "line": 1}, {"w": "می‌گی", "s": 3.037, "e": 3.296, "line": 1}, {"w": "چیه؟", "s": 3.296, "e": 3.778, "line": 1}, {"w": "«از", "s": 4.673, "e": 4.84, "line": 2}, {"w": "فردا", "s": 4.84, "e": 5.229, "line": 2}, {"w": "شروع", "s": 5.229, "e": 5.544, "line": 2}, {"w": "می‌کنم.»", "s": 5.544, "e": 5.906, "line": 2}, {"w": "«فردا", "s": 6.264, "e": 6.599, "line": 3}, {"w": "زود", "s": 6.599, "e": 6.951, "line": 3}, {"w": "بیدار", "s": 6.951, "e": 7.285, "line": 3}, {"w": "می‌شم،", "s": 7.285, "e": 7.613, "line": 3}, {"w": "فردا", "s": 