{
"total": 35.268,
"segs": [
{
"n": 1,
"text": "وقتی اسپرم‌ها شلیک می‌شن بیرون،",
"start": 0.25,
"end": 2.173
},
{
"n": 2,
"text": "بیشتر مردم فکر می‌کنن یه مسابقه‌ی ساده شروع می‌شه.",
"start": 2.333,
"end": 5.194
},
{
"n": 3,
"text": "همه می‌دوئن، سریع‌ترین به تخمک می‌رسه، و یه زندگی تازه شروع می‌شه.",
"start": 5.354,
"end": 9.242
},
{
"n": 4,
"text": "ولی این فقط یه افسانه‌ست.",
"start": 9.402,
"end": 11.024
},
{
"n": 5,
"text": "همون لحظه‌ی اول، محیط اسیدی بهشون حمله می‌کنه، و میلیون‌ها تاشون همون‌جا می‌میرن.",
"start": 11.184,
"end": 16.523
},
{
"n": 6,
"text": "مایعی که همراهشونه، اسید رو خنثی می‌کنه تا بقیه یه فرصت پیدا کنن.",
"start": 16.683,
"end": 20.593
},
{
"n": 7,
"text": "بازمانده‌ها باید از یه دریای مخاط چسبناک شنا کنن و رد شن.",
"start": 20.753,
"end": 24.428
},
{
"n": 8,
"text": "بعد سیستم ایمنی می‌رسه، و هر سلول غریبه‌ای رو که ببینه، نابود می‌کنه.",
"start": 24.588,
"end": 28.621
},
{
"n": 9,
"text": "از حدود دویست و پنجاه میلیون اسپرم، فقط چند صدتا به تخمک می‌رسن.",
"start": 28.781,
"end": 32.702
},
{
"n": 10,
"text": "و آخرش، فقط یکی‌شون واردش می‌شه.",
"start": 32.862,
"end": 34.908
}
],
