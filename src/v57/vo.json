{"total": 171.725, "segs": [{"n": 1, "start": 0.0, "end": 3.262, "text": "توی این روستا، یه مترسک هر شب بچه‌ها رو می‌شمره."}, {"n": 2, "start": 3.54, "end": 5.596, "text": "آخه همیشه باید دقیقاً بیست تا باشن."}, {"n": 3, "start": 5.831, "end": 8.609, "text": "اگه بشمره بیست و یک... یکی رو می‌بره توی ذرت‌ها."}, {"n": 4, "start": 9.035, "end": 10.262, "text": "ما بهش می‌گیم آقای گونی."}, {"n": 5, "start": 10.516, "end": 14.338, "text": "واسه همین اینجا هیچ‌کس بچه‌دار نمی‌شه، تا وقتی یکی هجده سالش بشه."}, {"n": 6, "start": 14.573, "end": 16.829, "text": "معلممون دقیقاً بیست تا برگه چاپ می‌کنه."}, {"n": 7, "start": 17.064, "end": 20.423, "text": "و روی هر کیکِ تولد، بیست تا شمع هست. فقط برای یادآوری."}, {"n": 8, "start": 20.658, "end": 21.729, "text": "یه قانونِ دیگه هم هست."}, {"n": 9, "start": 21.996, "end": 25.632, "text": "اگه آقای گونی کمتر از بیست تا بشمره... باید یکی رو برگردونه."}, {"n": 10, "start": 25.867, "end": 27.15, "text": "تا حالا هیچ‌وقت پیش نیومده."}, {"n": 11, "start": 27.385, "end": 29.502, "text": "بابابزرگم یه حرفِ عجیب درباره‌ش می‌زنه."}, {"n": 12, "start": 29.867, "end": 33.095, "text": "«مترسک همه‌چیزِ مزرعه رو می‌شمره... به‌جز مترسک‌ها.»"}, {"n": 13, "start": 33.33, "end": 37.392, "text": "یه بند شلوارِ کوچیک هم کنارِ در به یه قلاب آویزون کرده. هیچ‌وقت نمی‌گه چرا."}, {"n": 14, "start": 37.64, "end": 39.849, "text": "اسمِ من کیانه، و من همه‌چیز رو می‌شمرم."}, {"n": 15, "start": 40.084, "end": 41.491, "text": "پله‌ها، ستاره‌ها..."}, {"n": 16, "start": 41.726, "end": 44.277, "text": "من بچه‌ی شماره‌ی بیستم. کوچیک‌ترینشون."}, {"n": 17, "start": 44.512, "end": 46.731, "text": "تا اینکه یه روز صبح، مامان از بیمارستان اومد..."}, {"n": 18, "start": 46.968, "end": 49.056, "text": "با خواهر کوچولوم، رها. بیست و یک."}, {"n": 19, "start": 49.326, "end": 52.772, "text": "بابا رها رو گذاشت توی وانت، و مستقیم روند سمتِ تابلوی ورودی."}, {"n": 20, "start": 53.007, "end": 55.157, "text": "اگه توی روستا نباشه، شمرده نمی‌شه."}, {"n": 21, "start": 55.392, "end": 56.481, "text": "وانت رسید به تابلو..."}, {"n": 22, "start": 56.481, "end": 58.908, "text": "و چراغاش خاموش شد. موتورش خاموش شد."}, {"n": 23, "start": 59.143, "end": 62.816, "text": "و درست زیرِ تابلو، روبه‌روی وانت... آقای گونی وایساده بود."}, {"n": 24, "start": 63.268, "end": 64.939, "text": "بابا خیلی آروم برگشت."}, {"n": 25, "start": 65.175, "end": 66.667, "text": "مامان تمومِ روز گریه کرد."}, {"n": 26, "start": 66.902, "end": 67.559, "text": "و من شمردم."}, {"n": 27, "start": 67.794, "end": 71.494, "text": "بیست تا بچه. یه خواهر. یه مترسک که مترسک‌ها رو نمی‌شمره."}, {"n": 28, "start": 71.729, "end": 74.422, "text": "دویدم بالا، توی انباریِ زیرشیروونیِ مادربزرگ."}, {"n": 29, "start": 74.657, "end": 76.524, "text": "گونی‌های کهنه و کلاه‌های حصیری."}, {"n": 30, "start": 76.789, "end": 78.659, "text": "بعد درِ همه‌ی خونه‌های روستا رو زدم."}, {"n": 31, "start": 78.894, "end": 82.466, "text": "«اینو بپوش. نیمه‌شب توی حیاطت وایسا. تکون نخور. بهم اعتماد کن.»"}, {"n": 32, "start": 82.711, "end": 85.538, "text": "بیست و یک مترسکِ کوچولو، توی بیست و یک حیاط."}, {"n": 33, "start": 85.773, "end": 88.936, "text": "رها توی یه لباسِ گونیِ کوچولو، توی بغلم خواب بود."}, {"n": 34, "start": 89.171, "end": 92.148, "text": "ساعت دوازده. خرچ... خرچ... خرچ."}, {"n": 35, "start": 92.583, "end": 94.313, "text": "یه چیزی از توی ذرت‌ها اومد بیرون."}, {"n": 36, "start": 94.548, "end": 95.366, "text": "سه متر قد."}, {"n": 37, "start": 95.76, "end": 98.279, "text": "یه گونی به‌جای صورت، با یه لبخندِ دوخته‌شده."}, {"n": 38, "start": 98.514, "end": 99.451, "text": "انگشت‌هایی از چوب."}, {"n": 39, "start": 99.703, "end": 102.079, "text": "جلوی اولین حیاط وایساد. تق. سکوت."}, {"n": 40, "start": 102.405, "end": 103.896, "text": "دومی. تق. سکوت."}, {"n": 41, "start": 104.214, "end": 106.774, "text": "توی حیاطِ میلانی‌ها، امیدِ کوچولو ریز خندید."}, {"n": 42, "start": 107.009, "end": 107.591, "text": "فقط یه بار."}, {"n": 43, "start": 107.826, "end": 109.025, "text": "آقای گونی خشکش زد."}, {"n": 44, "start": 109.26, "end": 113.794, "text": "اون‌قدر خم شد که لبخندِ دوخته‌ش یه بند انگشت با کلاهِ امید فاصله داشت."}, {"n": 45, "start": 114.029, "end": 116.817, "text": "ثانیه‌ها رو شمردم. هفت... هشت... نُه..."}, {"n": 46, "start": 117.052, "end": 119.045, "text": "بعد صاف شد و رفت سراغِ بعدی."}, {"n": 47, "start": 118.77, "end": 121.2, "text": "تق. تق. تق. بعد رسید به حیاطِ ما."}, {"n": 48, "start": 121.48, "end": 123.319, "text": "یه انگشتِ چوبی کلاهم رو خراشید."}, {"n": 49, "start": 123.554, "end": 124.569, "text": "دماغِ رها جمع شد."}, {"n": 50, "start": 124.804, "end": 126.262, "text": "عطسه نکن... عطسه نکن..."}, {"n": 51, "start": 126.497, "end": 127.834, "text": "آقای گونی صاف وایساد."}, {"n": 52, "start": 128.069, "end": 130.771, "text": "و با یه صدایی مثلِ برگِ خشک گفت: «صفر.»"}, {"n": 53, "start": 131.006, "end": 133.522, "text": "بعد برگشت سمتِ مزرعه و دستاش رو برد بالا."}, {"n": 54, "start": 134.057, "end": 135.852, "text": "چون قانون شاملِ خودش هم می‌شه."}, {"n": 55, "start": 136.087, "end": 138.557, "text": "یه دختر با کاپشنِ پفیِ دهه‌ی شصت اومد بیرون."}, {"n": 56, "start": 138.792, "end": 139.113, "text": "یک."}, {"n": 57, "start": 139.376, "end": 141.261, "text": "یه پسر با یه یویوی چوبی. دو."}, {"n": 58, "start": 141.498, "end": 142.519, "text": "تمومِ شب شمرد."}, {"n": 59, "start": 142.753, "end": 144.685, "text": "بیستمی، آخرین نفر، اومد بیرون."}, {"n": 60, "start": 144.92, "end": 146.848, "text": "یه پسرِ لاغر... با بند شلوار."}, {"n": 61, "start": 147.213, "end": 148.83, "text": "عصای بابابزرگ از دستش افتاد."}, {"n": 62, "start": 149.086, "end": 152.153, "text": "تقی. داداش کوچیکش. گم‌شده از سالِ هزار و سیصد و چهل."}, {"n": 63, "start": 152.767, "end": 153.935, "text": "بند شلوار مالِ اون بود."}, {"n": 64, "start": 154.169, "end": 156.808, "text": "خورشید که دراومد، آقای گونی روی چوبش وارفت."}, {"n": 65, "start": 157.256, "end": 158.53, "text": "دوباره فقط کاه بود."}, {"n": 66, "start": 158.772, "end": 162.976, "text": "حالا همه‌ی بچه‌ها با لباسِ مترسک می‌خوابن... و هر شب، یکی برمی‌گرده."}, {"n": 67, "start": 163.12, "end": 167.8, "text": "دیشب، یه دختر بود از سالِ هزار و سیصد و سیزده. فکر می‌کنه گوشی‌هامون جادوئه."}, {"n": 68, "start": 168.0, "end": 170.25, "text": "ولی امشب... داره لایک‌ها رو می‌شمره."}, {"n": 69, "start": 170.36, "end": 171.4, "text": "و لایکِ تو کمه."}], "words": [{"w": "توی", "s": 0.0, "e": 0.209, "line": 1}, {"w": "این", "s": 0.209, "e": 0.383, "line": 1}, {"w": "روستا،", "s": 0.383, "e": 0.887, "line": 1}, {"w": "یه", "s": 0.887, "e": 1.287, "line": 1}, {"w": "مترسک", "s": 1.287, "e": 1.843, "line": 1}, {"w": "هر", "s": 1.843, "e": 2.122, "line": 1}, {"w": "شب", "s": 2.122, "e": 2.353, "line": 1}, {"w": "بچه‌ها", "s": 2.353, "e": 2.816, "line": 1}, {"w": "رو", "s": 2.816, "e": 3.047, "line": 1}, {"w": "می‌شمره.", "s": 3.047, "e": 3.262, "line": 1}, {"w": "آخه", "s": 3.54, "e": 3.683, "line": 2}, {"w": "همیشه", "s": 3.683, "e": 4.153, "line": 2}, {"w": "باید", "s": 4.153, "e": 4.379, "line": 2}, {"w": "دقیقاً", "s": 4.379, "e": 4.849, "line": 2}, {"w": "بیست", "s": 4.849, "e": 5.142, "line": 2}, {"w": "تا", "s": 5.142, "e": 5.318, "line": 2}, {"w": "باشن.", "s": 5.318, "e": 5.596, "line": 2}, {"w": "اگه", "s": 5.831, "e": 5.984, "line": 3}, {"w": "بشمره", "s": 5.984, "e": 6.297, "line": 3}, {"w": "بیست", "s": 6.297, "e": 6.558, "line": 3}, {"w": "و", "s": 6.558, "e": 6.662, "line": 3}, {"w": "یک...", "s": 6.662, "e": 7.201, "line": 3}, {"w": "یکی", "s": 7.413, "e": 7.687, "line": 3}, {"w": "رو", "s": 7.687, "e": 7.705, "line": 3}, {"w": "می‌بره", "s": 7.705, "e": 8.0, "line": 3}, {"w": "توی", "s": 8.0, "e": 8.122, "line": 3}, {"w": "ذرت‌ها.", "s": 8.122, "e": 8.609, "line": 3}, {"w": "ما", "s": 9.035, "e": 9.097, "line": 4}, {"w": "بهش", "s": 9.097, "e": 9.323, "line": 4}, {"w": "می‌گیم", "s": 9.323, "e": 9.584, "line": 4}, {"w": "آقای", "s": 9.584, "e": 9.897, "line": 4}, {"w": "گونی.", "s": 9.897, "e": 10.262, "line": 4}, {"w": "واسه", "s": 10.516, "e": 10.674, "line": 5}, {"w": "همی