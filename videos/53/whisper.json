{"segments": [{"start": 0.0, "end": 3.82, "text": " تا حالا شده احساس کنی همه چیز داره از کنترولت خارج میشه؟"}, {"start": 4.38, "end": 5.84, "text": " قلبت تونتر میزنه،"}, {"start": 5.84, "end": 8.34, "text": " ذهنت پر از فکرهای مختلف میشه"}, {"start": 8.34, "end": 12.18, "text": " و هر چقدر بیشتر تلاش میکنی همه چیز رو درست کنی،"}, {"start": 12.18, "end": 14.22, "text": " انگار اوزا بدتر میشه."}, {"start": 15.06, "end": 17.58, "text": " آب و هوا، رفتار آدم ها،"}, {"start": 17.58, "end": 21.82, "text": " اتفاقات گذشته و حتی آیندهی که هنوز از راه نرسیده."}, {"start": 22.7, "end": 26.0, "text": " تو نمیتونی هیچ کدوم از اینها رو به طور کامل کنترول کنی."}, {"start": 26.0, "end": 29.68, "text": " اما بیشتر آدم ها تمام زندگیشون رو"}, {"start": 29.68, "end": 32.88, "text": " صرف تلاش برای کنترول همین چیزها میکنن."}, {"start": 33.44, "end": 37.16, "text": " اینجاست که یه فلسفه قدیمی وارد داستان میشه،"}, {"start": 37.16, "end": 39.74, "text": " فلسفهی به اسم رواقیگری."}, {"start": 40.26, "end": 43.48, "text": " رواقی ها به یه حقیقت ساده باور داشتن."}, {"start": 43.7, "end": 46.44, "text": " تو نمیتونی توفان رو متوقف کنی،"}, {"start": 46.96, "end": 51.14, "text": " اما میتونی انتخاب کنی که وسط توفان چطور بیستی."}, {"start": 51.46, "end": 55.6, "text": " فرض کن دو نفر دقیقا توی یک شرایط زندگی میکنن."}, {"start": 56.0, "end": 58.06, "text": " هر دو با مشکلات روبرومیشن،"}, {"start": 58.06, "end": 62.58, "text": " هر دو شکست میخورن و هر دو روزهای سختی رو تجربه میکنن."}, {"start": 62.64, "end": 65.74, "text": " اما یه تفاوت بزرگ بینشون وجود داره."}, {"start": 65.98, "end": 70.96, "text": " نفر اول اجازه میده هر اتفاق کچیکی حالش رو خراب کنه."}, {"start": 71.28, "end": 74.18, "text": " یکی بهش بی احترامی میکنه، عصبانی میشه."}, {"start": 74.34, "end": 77.68, "text": " اوتوبوس رو از دست میده، تمام روزش خراب میشه."}, {"start": 77.86, "end": 81.98, "text": " توی کارش شکست میخوره، خودش رو یه آدم بازنده میدونه."}, {"start": 81.98, "end": 85.68, "text": " اما نفر دوم نگاه متفاوتی داره."}, {"start": 86.32000000000001, "end": 89.0, "text": " اون هم ناراحت میشه، اون هم گاهی میترسه."}, {"start": 89.12, "end": 94.1, "text": " اما یاد گرفته قبل از واکنش نشون دادن یه لحظه مکس کنه."}, {"start": 94.16, "end": 97.18, "text": " چون فهمیده همه چیز دست اون نیست."}, {"start": 98.04, "end": 100.06, "text": " بعضی چیزها از کنترول ما خارجن."}, {"start": 100.2, "end": 107.22, "text": " مثل گذشته، نظر دیگران، رفتار آدم ها و اتفاقاتی که بدون اجازه ما روخ میدن."}, {"start": 107.4, "end": 110.92, "text": " اما یه چیز همیشه میتونه دست خودمون باشه."}, {"start": 110.92, "end": 114.8, "text": " این که چطور به اون اتفاقات واکنش نشون بدیم."}, {"start": 115.54, "end": 120.12, "text": " وقتی کسی بهت توحین میکنه، مجبور نیستی جوابش رو با عصبانیت بدی."}, {"start": 120.22, "end": 123.88, "text": " وقتی شکست میخوری، مجبور نیستی تسلیم بشی."}, {"start": 123.98, "end": 129.92, "text": " و وقتی زندگی طبق برنامت پیش نمیره، مجبور نیستی با تمام دنیا بجنگی."}, {"start": 130.24, "end": 135.84, "text": " البته گفتنش آسونه، چون ذهن تو همیشه سعی میکنه تحریکت کنه."}, {"start": 135.84, "end": 140.86, "text": " بهت میگه عصبانی شو، جوابش رو بده، ثابت کن که حق با توه."}, {"start": 141.04, "end": 148.52, "text": " اما هر بار که بدون فکر واکنش نشون میدی، اختیار آرامشت رو به اتفاقات بیرونی میسپری."}, {"start": 148.9, "end": 152.64, "text": " قدرت واقعی این نیست که بتونی همه رو شکست بدی."}, {"start": 152.72, "end": 158.26, "text": " قدرت واقعی اینه که وقتی عصبانی هستی، بتونی خودت رو کنترول کنی."}, {"start": 158.46, "end": 163.3, "text": " شاید فردو دوباره شکست بخوری، شاید کسی بهت احترام نذاره،"}, {"start": 163.3, "end": 166.28, "text": " شاید هیچ چیز اونطوری که میخواستی پیش نره."}, {"start": 166.34, "end": 172.18, "text": " اما یادت باشه، قرار نیست همیشه دنیا متابقه میل تو تغییر کنه."}, {"start": 172.36, "end": 175.92, "text": " گاهی این تویی که باید نگاهت رو تغییر بدی."}, {"start": 176.0, "end": 180.68, "text": " چون آرامش واقعی از کنترول کردن دنیا به دست نمیاد."}, {"start": 180.82, "end": 184.14, "text": " از کنترول کردن واکنش خودت شروع میشه."}], "words": [{"text": "تا", "start": 0.0, "end": 0.16, "p": 0.9929979741573334}, {"text": "حالا", "start": 0.16, "end": 0.4, "p": 0.9986291726430258}, {"text": "شده", "start": 0.4, "end": 0.64, "p": 0.9998385508855184}, {"text": "احساس", "start": 0.64, "end": 1.04, "p": 0.9967249482870102}, {"text": "کنی", "start": 1.04, "end": 1.3, "p": 0.9995447198549906}, {"text": "همه", "start": 1.3, "end": 1.7, "p": 0.983189324537913}, {"text": "چیز", "start": 1.7, "end": 1.98, "p": 0.9998980561892191}, {"text": "داره", "start": 1.98, "end": 2.24, "p": 0.9988247553507487}, {"text": "از", "start": 2.24, "end": 2.38, "p": 0.9998904764652252}, {"text": "کنترولت", "start": 2.38, "end": 2.96, "p": 0.9815442800521851}, {"text": "خارج", "start": 2.96, "end": 3.32, "p": 0.9994899233182272}, {"text": "میشه؟", "start": 3.32, "end": 3.82, "p": 0.8515843600034714}, {"text": "قلبت", "start": 4.38, "end": 4.74, "p": 0.8606783151626587}, {"text": "تونتر", "start": 4.74, "end": 5.28, "p": 0.8512645363807678}, {"text": "میزنه،", "start": 5.28, "end": 5.84, "p": 0.9417043685913086}, {"text": "ذهنت", "start": 5.84, "end": 6.62, "p": 0.9660923679669698}, {"text": "پر", "start": 6.62, "end": 6.92, "p": 0.9968418180942535}, {"text": "از", "start": 6.92, "end": 7.12, "p": 0.9971633851528168}, {"text": "فکرهای", "start": 7.12, "end": 7.5, "p": 0.9843984365463256}, {"text": "مختلف", "start": 7.5, "end": 7.98, "p": 0.995821217695872}, {"text": "میشه", "start": 7.98, "end": 8.34, "p": 0.9997751514116923}, {"text": "و", "start": 8.34, "end": 9.04, "p": 0.9430789351463318}, {"text": "هر", "start": 9.04, "end": 9.26, "p": 0.9997082650661469}, {"text": "چقدر", "start": 9.26, "end": 9.62, "p": 0.8560532927513123}, {"text": "بیشتر", "start": 9.62, "end": 10.14, "p": 0.999839448928833}, {"text": "تلاش", "start": 10.14, "end": 10.42, "p": 0.9978109995524088}, {"text": "میکنی", "start": 10.42, "end": 10.84, "p": 0.9947962015867233}, {"text": "همه", "start": 10.84, "end": 1